<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FieldSales.Catalogue.Contracts" />
    <Using Include="FieldSales.Identity.Services" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldSales.Quantities\FieldSales.Quantities.csproj" />
    <ProjectReference Include="..\FieldSales.ReferenceData\FieldSales.ReferenceData.csproj" />
    <ProjectReference Include="..\FieldSales.StaffAccess\FieldSales.StaffAccess.csproj" />
    <ProjectReference Include="..\FieldSales.Catalogue.Contracts\FieldSales.Catalogue.Contracts.csproj" />
    <ProjectReference Include="..\FieldSales.Directory.Contracts\FieldSales.Directory.Contracts.csproj" />
    <ProjectReference Include="..\FieldSales.ServiceDefaults\FieldSales.ServiceDefaults.csproj" />
    <ProjectReference Include="..\FieldSales.Api\FieldSales.Api.csproj" />
    <ProjectReference Include="..\FieldSales.Web\FieldSales.Web.csproj" />
    <ProjectReference Include="..\FieldSales.Identity.Admin.Services\FieldSales.Identity.Admin.Services.csproj" />
    <ProjectReference Include="..\FieldSales.Identity\src\FieldSales.Identity\FieldSales.Identity.csproj" />
  </ItemGroup>

  <Target Name="CopyIdentityAppSettings" AfterTargets="Build">
    <Copy SourceFiles="..\FieldSales.Identity\src\FieldSales.Identity\appsettings.json" DestinationFiles="$(TargetDir)appsettings.json" />
  </Target>

</Project>
