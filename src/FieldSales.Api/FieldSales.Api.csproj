<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldSales.DemoData" />
    <!-- Domain rules (for example Main Contact changes) are internal to the API; unit tests exercise them directly. -->
    <InternalsVisibleTo Include="FieldSales.Api.UnitTests" />
    <ProjectReference Include="..\FieldSales.ServiceDefaults\FieldSales.ServiceDefaults.csproj" />
    <ProjectReference Include="..\FieldSales.StaffAccess\FieldSales.StaffAccess.csproj" />
    <ProjectReference Include="..\FieldSales.Quantities\FieldSales.Quantities.csproj" />
    <ProjectReference Include="..\FieldSales.ReferenceData\FieldSales.ReferenceData.csproj" />
    <ProjectReference Include="..\FieldSales.Catalogue.Contracts\FieldSales.Catalogue.Contracts.csproj" />
    <ProjectReference Include="..\FieldSales.Directory.Contracts\FieldSales.Directory.Contracts.csproj" />
    <ProjectReference Include="..\FieldSales.Snapshot.Contracts\FieldSales.Snapshot.Contracts.csproj" />
    <ProjectReference Include="..\FieldSales.Ordering.Contracts\FieldSales.Ordering.Contracts.csproj" />
  </ItemGroup>

</Project>
