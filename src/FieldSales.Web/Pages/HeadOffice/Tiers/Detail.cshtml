@page "/HeadOffice/Tiers/{id:guid}"
@model FieldSales.Web.Pages.HeadOffice.Tiers.DetailModel
@using System.Globalization
@using FieldSales.Web.Pages.HeadOffice.Tiers
@{
    ViewData["Title"] = Model.Tier.Name;
}
@functions {
    // An override form; the refused one keeps what was entered and shows why.
    private async Task OverrideForm(Guid productId, string label, string kind, decimal? value)
    {
        bool refused = Model.RefusedProduct == productId;
        string chosen = refused ? Model.Override!.Kind : kind;
        decimal? shown = refused ? Model.Override!.Value : value;
        <form method="post" asp-page-handler="Override" asp-route-id="@Model.Tier.Id" class="tier-override-form">
            <input type="hidden" name="Override.ProductId" value="@productId" />
            <input type="hidden" name="Find" value="@Model.Find" />
            <select name="Override.Kind" aria-label="Override type">
                <option value="@OverrideInput.PercentKind" selected="@(chosen == OverrideInput.PercentKind)">% off base</option>
                <option value="@OverrideInput.FixedKind" selected="@(chosen == OverrideInput.FixedKind)">Fixed price (€)</option>
            </select>
            <input name="Override.Value" type="number" min="0.01" step="0.01" required aria-label="Override value"
                   value="@(shown?.ToString(CultureInfo.InvariantCulture))" />
            <button type="submit" class="button">@label</button>
            @if (refused)
            {
                <span role="alert">@string.Join(" ", ViewData.ModelState[$"{nameof(DetailModel.Override)}.{nameof(OverrideInput.Value)}"]?.Errors.Select(error => error.ErrorMessage) ?? [])</span>
            }
        </form>
        await Task.CompletedTask;
    }
}
<p><a asp-page="Index">Back to price tiers</a></p>
<h1>@Model.Tier.Name</h1>
<p class="tier-default">@TierText.Percent(Model.Tier.PercentOff) off base</p>

<section aria-labelledby="overrides-heading">
    <h2 id="overrides-heading">Overrides</h2>
    @if (Model.Tier.Overrides.Count == 0)
    {
        <p>No overrides yet. Every product is @TierText.Percent(Model.Tier.PercentOff) off its current base price.</p>
    }
    else
    {
        <ul class="tier-overrides" aria-label="Overrides">
            @foreach (var entry in Model.Tier.Overrides)
            {
                <li data-override>
                    <p><strong>@entry.Name</strong> · @TierText.Row(entry)</p>
                    @{ await OverrideForm(entry.ProductId, "Change", entry.FixedPrice is null ? OverrideInput.PercentKind : OverrideInput.FixedKind, entry.PercentOff ?? entry.FixedPrice); }
                    <form method="post" asp-page-handler="Remove" asp-route-id="@Model.Tier.Id" asp-route-productId="@entry.ProductId">
                        <button type="submit">Remove override</button>
                    </form>
                </li>
            }
        </ul>
    }
    <h3>+ Override</h3>
    <form method="get" class="product-search-form">
        <label asp-for="Find">Find a product</label>
        <input asp-for="Find" type="search" placeholder="Code or name" />
        <button type="submit" class="button">Search</button>
    </form>
    @if (!string.IsNullOrEmpty(Model.Find))
    {
        <p role="status">@Model.MatchCount @(Model.MatchCount == 1 ? "product matches" : "products match")@(Model.MatchCount > Model.Matches.Count ? $"; showing the first {Model.Matches.Count}" : "")</p>
        <ul class="tier-matches" aria-label="Matching products">
            @foreach (var product in Model.Matches)
            {
                <li data-match>
                    <p><strong>@product.Code · @product.Name</strong> · @(product.CurrentPrice is { } price ? "list " + TierText.Money(price.Amount, product.Unit) : "no list price today")</p>
                    @if (Model.HasOverride(product.Id))
                    {
                        <p>Already has an override on this tier.</p>
                    }
                    else
                    {
                        await OverrideForm(product.Id, "Add override", OverrideInput.PercentKind, null);
                    }
                </li>
            }
        </ul>
    }
</section>

<section aria-labelledby="terms-heading">
    <h2 id="terms-heading">Tier</h2>
    <form method="post" asp-page-handler="Terms" asp-route-id="@Model.Tier.Id" class="product-form">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <label asp-for="Terms!.Name">Tier name</label>
        <input asp-for="Terms!.Name" maxlength="100" required />
        <span asp-validation-for="Terms!.Name"></span>
        <label asp-for="Terms!.PercentOff">Percentage off base</label>
        <input asp-for="Terms!.PercentOff" type="number" min="0.01" max="99.99" step="0.01" required />
        <span asp-validation-for="Terms!.PercentOff"></span>
        <p>Products without an override follow this percentage and their base price as it changes.</p>
        <button type="submit" class="button">Save tier</button>
    </form>
</section>
