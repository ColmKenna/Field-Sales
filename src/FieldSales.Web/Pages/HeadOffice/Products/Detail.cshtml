@page "/HeadOffice/Products/{id:guid}"
@model FieldSales.Web.Pages.HeadOffice.Products.DetailModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Details.Product.Name;
    var currency = CultureInfo.GetCultureInfo("en-IE");
}
<p><a asp-page="/HeadOffice/Index">Back to catalogue</a></p>
<h1>@Model.Details.Product.Code · @Model.Details.Product.Name</h1>
<partial name="_CategoryBreadcrumb" model="Model.Details.Breadcrumb" />
<div class="product-record">
    <section aria-labelledby="price-heading">
        <h2 id="price-heading">Base price</h2>
        @if (Model.Details.CurrentPrice is { } price)
        {
            @if (Model.UpcomingPrice is { } next)
            {
                var change = next.Amount > price.Amount ? "rising to" : next.Amount < price.Amount ? "falling to" : "changing to";
                <p class="price-summary">@price.Amount.ToString("C2", currency) · @change @next.Amount.ToString("C2", currency) on @next.EffectiveFrom.ToString("d MMM", CultureInfo.InvariantCulture)</p>
            }
            <p>@price.Amount.ToString("C2", currency) per @Model.Details.Product.Unit · Effective from @price.EffectiveFrom.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</p>
        }
        else
        {
            <p>No price in effect.</p>
            @if (Model.UpcomingPrice is { } next)
            {
                <p>Starting at @next.Amount.ToString("C2", currency) on @next.EffectiveFrom.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</p>
            }
        }
        <form method="post" asp-page-handler="Price" class="product-form">
            <h3>Add a base price</h3>
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <label asp-for="BasePrice">Base price (€ per @Model.Details.Product.Unit)</label>
            <input asp-for="BasePrice" type="number" min="0" step="0.01" required aria-describedby="price-dates" />
            <span asp-validation-for="BasePrice" role="alert"></span>
            <label asp-for="EffectiveFrom">Effective from</label>
            <input asp-for="EffectiveFrom" type="date" required aria-describedby="price-dates price-capture-note" />
            <span asp-validation-for="EffectiveFrom" role="alert"></span>
            <p id="price-dates">Choose the date this price applies from. Previous prices stay in the history.</p>
            <p id="price-capture-note">Existing orders keep the price captured</p>
            <button type="submit" class="button">Add price</button>
        </form>
        <div class="price-history">
            <table>
                <caption>Base price history · newest first</caption>
                <thead><tr><th scope="col">Effective from</th><th scope="col">Price per @Model.Details.Product.Unit</th></tr></thead>
                <tbody>
                    @foreach (var entry in Model.PriceHistory)
                    {
                        <tr><td><time datetime="@entry.EffectiveFrom.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@entry.EffectiveFrom.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</time></td><td>@entry.Amount.ToString("C2", currency)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    @{
        // WI-062 (H-22): breaks in the product's unit, sorted by quantity, under the base price they compete with.
        bool each = Model.Details.Product.Unit == "Each";
        string unitText = each ? "" : " " + Model.Details.Product.Unit;
        string quantityStep = each ? "1" : (Model.Details.Product.QuantityStep ?? 0.000001m).ToString("0.######", CultureInfo.InvariantCulture);
        string Quantity(decimal? amount) => amount?.ToString("0.######", CultureInfo.InvariantCulture) ?? "";
        string Price(decimal? amount) => amount?.ToString("0.00", CultureInfo.InvariantCulture) ?? "";
        string Refused(string key) => string.Join(" ", ViewData.ModelState[key]?.Errors.Select(error => error.ErrorMessage) ?? []);
    }
    <section aria-labelledby="breaks-heading">
        <h2 id="breaks-heading">Quantity breaks</h2>
        <p class="breaks-base">@(Model.Details.CurrentPrice is { } basePrice
            ? $"Base price {basePrice.Amount.ToString("C2", currency)} {(each ? "each" : "per " + Model.Details.Product.Unit)}"
            : "No base price in effect.")</p>
        <form method="post" asp-page-handler="Breaks" class="product-form quantity-breaks-form">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            @if (Model.Breaks.Count == 0)
            {
                <p>No quantity breaks yet. Every quantity is at the base price.</p>
            }
            @for (int row = 0; row <= Model.Breaks.Count; row++)
            {
                bool adding = row == Model.Breaks.Count;
                var entry = adding ? new FieldSales.Web.Pages.HeadOffice.Products.QuantityBreakInputRow() : Model.Breaks[row];
                var saved = adding ? null : Model.SavedBreak(entry);
                <div class="quantity-break" data-break="@(adding ? "new" : row.ToString(CultureInfo.InvariantCulture))">
                    @if (adding)
                    {
                        <h3>Add a break</h3>
                    }
                    <label for="Breaks_@(row)__FromQuantity">From@(unitText)</label>
                    <input id="Breaks_@(row)__FromQuantity" name="Breaks[@row].FromQuantity" type="number" min="@quantityStep" step="@quantityStep"
                           value="@(ViewData.ModelState[$"Breaks[{row}].FromQuantity"]?.AttemptedValue ?? Quantity(entry.FromQuantity))" />
                    @if (Refused($"Breaks[{row}].FromQuantity") is { Length: > 0 } quantityRefused)
                    {
                        <span class="field-validation-error" role="alert">@quantityRefused</span>
                    }
                    <label for="Breaks_@(row)__Price">Price (€@(each ? "" : " per " + Model.Details.Product.Unit))</label>
                    <input id="Breaks_@(row)__Price" name="Breaks[@row].Price" type="number" min="0.01" step="0.01"
                           value="@(ViewData.ModelState[$"Breaks[{row}].Price"]?.AttemptedValue ?? Price(entry.Price))" />
                    @if (Refused($"Breaks[{row}].Price") is { Length: > 0 } priceRefused)
                    {
                        <span class="field-validation-error" role="alert">@priceRefused</span>
                    }
                    @if (saved is { AboveCheaperBreak: true })
                    {
                        <p class="tier-warning">This break is higher than the one below it and will never apply.</p>
                    }
                    @if (saved is { AboveBase: true })
                    {
                        <p class="tier-warning">This break is above the base price and will never apply.</p>
                    }
                    @if (!adding)
                    {
                        <button type="submit" name="remove" value="@row" formnovalidate>Remove</button>
                    }
                </div>
            }
            <p>Each break prices a line from that quantity upward. Breaks are listed by quantity once saved.</p>
            <button type="submit" class="button">Save breaks</button>
            <a asp-page="Detail" asp-route-id="@Model.Details.Product.Id">Cancel</a>
        </form>
    </section>
    <section aria-labelledby="unit-heading">
        <h2 id="unit-heading">Unit</h2>
        <form method="post" asp-page-handler="Unit" class="product-form" data-product-unit-form>
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <partial name="_UnitFields" model="@(new FieldSales.Web.Catalogue.ProductUnitFields(Model.Unit, Model.QuantityStep, Model.MinimumQuantity, Model.Details.CurrentPrice?.Amount, Model.Details.Product.Unit))" />
            <button type="submit" asp-page-handler="PreviewUnit" formnovalidate>Update preview</button>
            <button type="submit" class="button">Save unit</button>
        </form>
    </section>
    <section aria-labelledby="ranges-heading"><h2 id="ranges-heading">Ranges</h2><p>Unranged — orderable by all reps</p></section>
    <section aria-labelledby="replacements-heading"><h2 id="replacements-heading">Replacements</h2><p>No replacements yet.</p></section>
    <section aria-labelledby="classification-heading" class="classification-section">
        <h2 id="classification-heading">Classification</h2>
        <dl class="classification-summary">
            <div><dt>Profile</dt><dd>@(Model.Details.Profile is { } profile ? profile.Name + (profile.IsArchived ? " (archived)" : "") : "No profile yet.")</dd></div>
            <div><dt>Brands</dt><dd>
                @if (Model.Details.Brands is not { Count: > 0 }) { <span>No brands yet.</span> }
                else
                {
                    <ul>
                        @foreach (var brand in Model.Details.Brands.OrderByDescending(brand => brand.IsPrimary))
                        {
                            <li>@brand.Name@(brand.IsArchived ? " (archived)" : "")@(brand.IsPrimary ? " · Primary" : "")@(!brand.IsPrimary || brand.IsAlternative ? " · Alternative" : "")</li>
                        }
                    </ul>
                }
            </dd></div>
            <div><dt>Supplier</dt><dd>@(Model.Details.Supplier is { } supplier ? supplier.Name + (supplier.IsArchived ? " (archived)" : "") : "No supplier yet.")</dd></div>
            <div><dt>Restriction Group</dt><dd>@(Model.Details.RestrictionGroup is { } group ? group.Name + (group.IsArchived ? " (archived)" : "") : "No restriction group yet.")</dd></div>
        </dl>
        <form method="post" asp-page-handler="Classification" class="product-form classification-form">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <p id="classification-help">All fields are optional. Choose a primary brand before adding alternative brands. Existing archived selections can be kept or replaced.</p>
            <div class="classification-fields">
                <div class="classification-field">
                    <label asp-for="Classification!.ProfileId">Profile</label>
                    <select asp-for="Classification!.ProfileId" aria-describedby="classification-help">
                        <option value="">No profile</option>
                        @foreach (var item in Model.ProfileChoices)
                        {
                            <option value="@item.Id">@item.Name@(item.IsArchived ? " (archived)" : "")</option>
                        }
                    </select>
                    <span asp-validation-for="Classification!.ProfileId" role="alert"></span>
                </div>
                <div class="classification-field">
                    <label asp-for="Classification!.PrimaryBrandId">Primary brand</label>
                    <select asp-for="Classification!.PrimaryBrandId" aria-describedby="classification-help">
                        <option value="">No primary brand</option>
                        @foreach (var item in Model.BrandChoices)
                        {
                            <option value="@item.Id">@item.Name@(item.IsArchived ? " (archived)" : "")</option>
                        }
                    </select>
                    <span asp-validation-for="Classification!.PrimaryBrandId" role="alert"></span>
                </div>
                <div class="classification-field">
                    <label asp-for="Classification!.SupplierId">Supplier</label>
                    <select asp-for="Classification!.SupplierId" aria-describedby="classification-help">
                        <option value="">No supplier</option>
                        @foreach (var item in Model.SupplierChoices)
                        {
                            <option value="@item.Id">@item.Name@(item.IsArchived ? " (archived)" : "")</option>
                        }
                    </select>
                    <span asp-validation-for="Classification!.SupplierId" role="alert"></span>
                </div>
                <div class="classification-field">
                    <label asp-for="Classification!.RestrictionGroupId">Restriction group</label>
                    <select asp-for="Classification!.RestrictionGroupId" aria-describedby="classification-help">
                        <option value="">No restriction group</option>
                        @foreach (var item in Model.RestrictionGroupChoices)
                        {
                            <option value="@item.Id">@item.Name@(item.IsArchived ? " (archived)" : "")</option>
                        }
                    </select>
                    <span asp-validation-for="Classification!.RestrictionGroupId" role="alert"></span>
                </div>
            </div>
            <fieldset class="alternative-brands" aria-describedby="classification-help">
                <legend>Alternative brands</legend>
                @if (Model.BrandChoices.Count == 0) { <p>No brands available.</p> }
                @foreach (var item in Model.BrandChoices)
                {
                    <label class="brand-choice" for="alternative-@item.Id">
                        <input type="checkbox" id="alternative-@item.Id" name="Classification.AlternativeBrandIds" value="@item.Id" checked="@(Model.Classification!.AlternativeBrandIds.Contains(item.Id))" />
                        <span>@item.Name@(item.IsArchived ? " (archived)" : "")</span>
                    </label>
                }
                <span asp-validation-for="Classification!.AlternativeBrandIds" role="alert"></span>
            </fieldset>
            <button type="submit" class="button">Save classification</button>
        </form>
    </section>
    <section aria-labelledby="attributes-heading"><h2 id="attributes-heading">Attributes</h2>
        @if (Model.Details.Attributes.Count == 0)
        {
            <p>No attributes yet.</p>
        }
        else
        {
            <dl>
                @foreach (var item in Model.Details.Attributes)
                {
                    <dt>@item.Name@(item.IsArchived ? " (archived)" : "")</dt><dd>@item.Value</dd>
                }
            </dl>
        }
        <form method="post" asp-page-handler="Attribute" class="attribute-form">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="form-field">
                <label asp-for="Attribute!.NameId">Attribute name</label>
                <select asp-for="Attribute!.NameId" aria-describedby="attribute-help">
                    <option value="">Choose an attribute name</option>
                    @if (Model.Attribute!.NameId is Guid selected && !Model.AttributeNameChoices.Any(item => item.Id == selected))
                    {
                        <option value="@selected" disabled>Selection unavailable</option>
                    }
                    @foreach (var item in Model.AttributeNameChoices)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
                <span asp-validation-for="Attribute!.NameId" role="alert"></span>
            </div>
            <div class="form-field">
                <label asp-for="Attribute!.Value">Value</label>
                <textarea asp-for="Attribute!.Value" rows="2" aria-describedby="attribute-help"></textarea>
                <span asp-validation-for="Attribute!.Value" role="alert"></span>
            </div>
            <p id="attribute-help">Choose a name from the reference list and add this product's value. Archived names stay on existing rows.</p>
            @if (Model.AttributeNameChoices.Count == 0) { <p>No active attribute names are available.</p> }
            <button type="submit" class="button" disabled="@(Model.AttributeNameChoices.Count == 0)">Add attribute</button>
        </form>
    </section>
</div>
<p><a asp-page="Create">Create another product</a></p>
<script src="~/js/product-unit-form.js" asp-append-version="true" defer></script>
