@namespace FieldSales.Tablet.Components.Shared
@using System.Globalization
@using FieldSales.Quantities
@using FieldSales.Tablet.Core

@* T-5.5.1 (UX T7.7): the quantity popover a Low item opens to go on the order. The quantity starts empty every time, and Add
   to order stays unavailable until the product's own rules accept it. Shared with the order's Low tab (T-5.1.4); break prompts
   (T-6.5.1) go in its slot under the price. *@
<section class="quantity-popover" role="dialog" aria-modal="true" aria-labelledby="quantity-popover-heading">
    <header class="quantity-popover-header">
        <h2 id="quantity-popover-heading">@Product.Name</h2>
        <button type="button" class="secondary popover-close" aria-label="Close" disabled="@Busy" @onclick="CancelAsync">✕</button>
    </header>
    @if (Recorded.Length > 0) { <p class="popover-recorded">@Recorded</p> }
    @if (Quote is { } quote) { <p class="popover-price">@PriceText(quote.Winner.Amount, Product.Unit, quote.Winner)</p> }
    else { <p class="problem" role="status">@OrderStore.NoPrice</p> }
    @ChildContent
    <label for="popover-quantity">Quantity@(Product.Unit == "Each" ? "" : $" ({Product.Unit})")</label>
    <input id="popover-quantity" type="text" inputmode="decimal" autocomplete="off" value="@text" @oninput="Changed"
           disabled="@(Busy || !Priced)" aria-describedby="@(Problem is null ? null : "popover-quantity-problem")" />
    @if (Problem is { } problem) { <p id="popover-quantity-problem" class="problem" role="alert">@problem</p> }
    @if (Error is not null) { <p class="problem" role="alert">@Error</p> }
    <div class="order-actions">
        <button type="button" class="secondary" disabled="@Busy" @onclick="CancelAsync">Cancel</button>
        @* Named as shown; the rows behind name theirs "Add {product} to order". *@
        <button type="button" class="primary" aria-label="Add to order" disabled="@(!CanAdd)" @onclick="AddAsync">Add to order</button>
    </div>
</section>

@code {
    /// <summary>The product to order, with its price and ordering rules from the downloaded day.</summary>
    [Parameter, EditorRequired] public ProductSearchResult Product { get; set; } = default!;

    /// <summary>What was recorded for it on this visit, e.g. "counted 3" or "not counted"; nothing shown when blank.</summary>
    [Parameter] public string Recorded { get; set; } = "";

    [Parameter] public bool Busy { get; set; }

    /// <summary>What the shop prices with (WI-064): the popover shows the engine's winner at the quantity typed.</summary>
    [Parameter] public LocationPrices Prices { get; set; } = LocationPrices.None;

    /// <summary>Why the last add was refused, in the rep's words.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public EventCallback<decimal> OnAdd { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Shown under the price: where T-6.5.1's break prompt goes.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string text = "";

    private QuantityRules? Rules => QuantityRules.TryCreate(Product.Unit, Product.QuantityStep, Product.MinimumQuantity,
        out QuantityRules? rules, out _) ? rules : null;

    // Only digits and a decimal point count; anything else is no quantity, and the product's rule says what to enter.
    private decimal Amount => decimal.TryParse(text.Trim(), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture,
        out decimal amount) ? amount : 0m;

    /// <summary>Nothing until something is typed; then the product's own message, e.g. "Enter a quantity of 1 or more".</summary>
    private string? Problem => !Priced || text.Length == 0 ? null
        : Rules is { } rules ? rules.ValidateOrder(Amount).Error : OrderStore.RulesUnreadable;

    private bool CanAdd => !Busy && Priced && text.Trim().Length > 0 && Problem is null;

    // WI-064 D4: at the quantity typed once the product's rules accept it; before that, at its smallest orderable quantity.
    private FieldSales.Pricing.ResolvedPrice? Quote => Prices.Resolve(Product,
        text.Length > 0 && Rules is { } rules && rules.ValidateOrder(Amount).IsValid ? Amount : LocationPrices.Smallest(Product));

    // Whether anything prices the product for this shop: a list price today or a tier price.
    private bool Priced => Prices.Resolve(Product, LocationPrices.Smallest(Product)) is not null;

    private void Changed(ChangeEventArgs args) => text = args.Value?.ToString() ?? "";

    private Task AddAsync() => CanAdd ? OnAdd.InvokeAsync(Amount) : Task.CompletedTask;

    private Task CancelAsync() => Busy ? Task.CompletedTask : OnCancel.InvokeAsync();

    /// <summary>"€8.95 · list price", or "€3.20 per kg · list price" for a measured product; a tier or break names itself instead,
    /// "€11.50 · Tier B" (WI-064). Where the price came from in full is T-6.4.3's.</summary>
    public static string PriceText(decimal price, string unit, FieldSales.Pricing.PriceCandidate? winner = null) =>
        "€" + price.ToString("N2", CultureInfo.InvariantCulture) + (unit == "Each" ? "" : $" per {unit}")
        + (winner is null || winner.Kind == FieldSales.Pricing.PriceKinds.List ? " · list price" : $" · {winner.Label}");
}
