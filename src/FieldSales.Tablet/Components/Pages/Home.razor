@page "/home"
@using System.Diagnostics
@using Microsoft.AspNetCore.Components.Web.Virtualization
@implements IDisposable
@inject TabletApp Tablet
@inject NavigationManager Navigation

@* T-02 · Home (this slice: when the rep last synced and the downloaded Locations). Search and the Location screen arrive with T-4.2.x. *@
@if (home is not null)
{
    <section class="home">
        <header class="home-header">
            <h1>Today</h1>
            <p class="last-sync">@home.LastSynced</p>
            <button class="secondary" @onclick='() => Navigation.NavigateTo("/sync")'>Sync</button>
            <a class="catalogue-link" href="/products">Products</a>
            <a class="catalogue-link" href="/locations/search">Search shops</a>
        </header>
        @if (unsent is { Total: > 0 })
        {
            <a class="unsent-summary" href="/sync">Unsent: @unsent.Total@(unsent.NeedsAttention > 0 ? $" · {unsent.AttentionText}" : "")</a>
        }
        <h2>Your shops (@home.Locations.Count)</h2>
        @* Only the rows on screen are drawn, so opening stays quick at 500 or more shops (D3 budget). *@
        <div class="locations" role="list">
            <Virtualize TItem="HomeLocation" Items="shops" ItemSize="@RowHeight" OverscanCount="6">
                <ItemContent Context="location">
                    <div class="location" role="listitem" @key="location.Id"><strong>@location.Name</strong><span>@location.TownName · @location.CustomerName</span></div>
                </ItemContent>
            </Virtualize>
        </div>
    </section>
}

@code {
    private const float RowHeight = 64;
    private HomeView? home;
    private UnsentSummary? unsent;
    private List<HomeLocation> shops = [];
    private int load;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        TabletTiming.Mark("home");
        Tablet.Resumed += OnResumed;
        await GuardAsync(Tablet.EnterOnArrivalAsync);
    }

    private async Task GuardAsync(Func<Task<TabletEntry>> enter)
    {
        int current = ++load;
        long version = Tablet.SessionVersion;
        home = null; shops = []; unsent = null;
        StateHasChanged();
        long started = Stopwatch.GetTimestamp();
        TabletEntry entry = await enter();
        if (disposed || current != load || version != Tablet.SessionVersion) return;
        if (entry.Screen != EntryScreen.Home) { home = null; Navigation.NavigateTo("/"); return; }
        TimeSpan entered = Stopwatch.GetElapsedTime(started);
        HomeView read = Tablet.ReadHome(entry.RepSubject!);
        if (version != Tablet.SessionVersion) return;
        home = read;
        try { unsent = Tablet.ReadUnsentSummary(entry.RepSubject!); }
        catch (Exception error) when (error is IOException or InvalidDataException or Microsoft.Data.Sqlite.SqliteException or System.Text.Json.JsonException)
        { /* An unreadable count must not block access to the downloaded day. */ }
        shops = [.. home.Locations];
        TabletTiming.HomePrepared(entered, Stopwatch.GetElapsedTime(started) - entered);
        Tablet.ResumeCleanup(entry.RepSubject!);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (home is not null) TabletTiming.HomeShown(home.Locations.Count);
    }

    private void OnResumed() => _ = InvokeAsync(async () => { await GuardAsync(Tablet.EnterAsync); StateHasChanged(); });

    public void Dispose() { disposed = true; ++load; home = null; shops = []; Tablet.Resumed -= OnResumed; }
}
