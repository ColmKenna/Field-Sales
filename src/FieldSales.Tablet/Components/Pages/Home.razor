@page "/home"
@using System.Diagnostics
@using System.Globalization
@using FieldSales.Tablet.Components.Shared
@implements IDisposable
@inject TabletApp Tablet
@inject NavigationManager Navigation

@* T-02 · Today's local record. Visit planning supplies its ordered rows in a later slice. *@
@if (home is not null || problem is not null)
{
    <section class="home">
        <header class="home-header">
            <h1>@(record?.Day.ToString("ddd d MMM", CultureInfo.InvariantCulture) ?? "Today")</h1>
            @if (home is not null) { <p class="last-sync">@home.LastSynced</p> }
            <button class="secondary" @onclick='() => Navigation.NavigateTo("/sync")'>Sync</button>
            <a class="catalogue-link" href="/products">Products</a>
            <a class="catalogue-link" href="/locations/search">Search shops</a>
        </header>
        @if (record is not null) { <HomeDayView Record="record" /> }
        else { <p role="status" class="problem">@problem</p><a href="/sync">Open Sync &amp; unsent</a> }
    </section>
}

@code {
    private HomeView? home;
    private HomeDayRecord? record;
    private string? problem;
    private int load;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        TabletTiming.Mark("home");
        Tablet.Resumed += OnResumed;
        await GuardAsync(Tablet.EnterOnArrivalAsync);
    }

    private async Task GuardAsync(Func<Task<TabletEntry>> enter)
    {
        int current = ++load;
        long version = Tablet.SessionVersion;
        home = null; record = null; problem = null;
        StateHasChanged();
        long started = Stopwatch.GetTimestamp();
        TabletEntry entry = await enter();
        if (disposed || current != load || version != Tablet.SessionVersion) return;
        if (entry.Screen != EntryScreen.Home) { home = null; Navigation.NavigateTo("/"); return; }
        TimeSpan entered = Stopwatch.GetElapsedTime(started);
        HomeView? availableHome = null;
        try
        {
            HomeDayRecord read = await Task.Run(() =>
            {
                availableHome = Tablet.ReadHome(entry.RepSubject!);
                return Tablet.ReadHomeRecord(entry.RepSubject!);
            });
            if (disposed || current != load || version != Tablet.SessionVersion) return;
            home = availableHome;
            record = read;
        }
        catch (Exception error) when (error is IOException or InvalidDataException or Microsoft.Data.Sqlite.SqliteException or System.Text.Json.JsonException)
        {
            if (!disposed && current == load && version == Tablet.SessionVersion)
            {
                home = availableHome;
                problem = "Today's record couldn't be opened. Your saved work is still on this tablet.";
            }
            return;
        }
        TabletTiming.HomePrepared(entered, Stopwatch.GetElapsedTime(started) - entered);
        Tablet.ResumeCleanup(entry.RepSubject!);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (home is not null) TabletTiming.HomeShown(home.Locations.Count);
    }

    private void OnResumed() => _ = InvokeAsync(async () => { await GuardAsync(Tablet.EnterAsync); StateHasChanged(); });

    public void Dispose() { disposed = true; ++load; home = null; record = null; Tablet.Resumed -= OnResumed; }
}
