@page "/locations/{Id:guid}/calls/new"
@page "/locations/{Id:guid}/orders/{OrderId:guid}/calls/new"
@page "/locations/{Id:guid}/calls/{CallId:guid}/edit"
@inherits OfflineCataloguePage
@using FieldSales.Calls.Contracts
@using FieldSales.Ordering.Contracts
@using FieldSales.Tablet.Components.Shared

@* T-06 · Record call (T-5.3.1): one scrolling page (T6.1); the channel first, as two unselected options (T6.2); the save review
   is a dialog (T6.4). The stock check (T-5.4.1) starts from the shop's Suggested List; on Phone the same rows read as "Stock
   mentioned" (T-5.3.2, T6.5). A Low item goes on the shop's order through the quantity popover (T-5.5.1, T7.7). Competitor
   notes and campaign outcomes join this page with their own items.
   T-5.1.5 D5: opened from an order's Low tab (the orders/{OrderId} route), saving links that order to this Call and returns to
   order entry for it; Back returns to the order.
   T-5.6.1 (US-015): the calls/{CallId}/edit route is Edit Call, for a saved Call before Sync. It changes and removes what was
   recorded and never adds: no Add product, catalogue search, Add count, count on a Not checked row, new pitch notes, Add to order or
   Open order, and no Delete. "Record a follow-up call" stands where adding would be (WI-055 D2, D3). *@
<section class="record-call">
    <nav class="shop-back" aria-label="Call navigation">
        <a href="@BackHref" @onclick="BackToShop" @onclick:preventDefault="true">@BackLabel</a>
    </nav>
    @if (!Ready) { <h1>Record call</h1><p role="status">Opening call…</p> }
    else if (problem is not null) { <h1>@(Editing ? "Edit call unavailable" : "Record call unavailable")</h1><p role="alert">@problem</p> }
    else if (Editing && original is null) { <h1>Edit call unavailable</h1><p role="alert">@CallStore.NotOnTablet</p> }
    else if (!Editing && detail is not { IsAssigned: true }) { <h1>Record call unavailable</h1><p role="alert">@OrderStore.NotAssigned</p> }
    else
    {
        <header class="order-header">
            <h1>@(Editing ? "Edit call" : "Record call")</h1>
            <p class="order-shop">@(detail?.Location.Name ?? "Shop details unavailable")</p>
        </header>
        <fieldset class="call-channel">
            <legend>How</legend>
            @foreach (CallChannel option in Enum.GetValues<CallChannel>())
            {
                <button type="button" class="channel-option" aria-pressed="@(draft.Channel == option ? "true" : "false")"
                        disabled="@busy" @onclick="() => Choose(option)">@CallContract.Label(option)</button>
            }
        </fieldset>
        @StockCheck
        @if (Editing && !hadNotes)
        {
            <section class="call-section"><div class="order-actions">@FollowUp</div></section>
        }
        else
        {
        <section class="call-section">
            <h2 class="call-section-heading">
                <button type="button" class="section-header" aria-expanded="@(draft.NotesOpen ? "true" : "false")" aria-controls="pitch-notes-body"
                        @onclick="ToggleNotes">Pitch notes@(draft.Content.HasPitch ? " · added" : "")</button>
            </h2>
            @if (draft.NotesOpen)
            {
                <div id="pitch-notes-body" class="call-section-body">
                    <label for="pitch-notes">What did you pitch?</label>
                    <textarea id="pitch-notes" rows="4" maxlength="@CallContract.MaximumPitchNotesLength" value="@draft.Notes"
                              @oninput="NotesChanged" disabled="@busy"></textarea>
                </div>
            }
        </section>
        }
        @if (message is not null) { <p class="problem" role="alert">@message</p> }
        @if (ordering is { } product)
        {
            <QuantityPopover @key="product.Id" Product="product" Recorded="@Recorded(product)" Busy="busy" Error="@orderError"
                             OnAdd="AddToOrderAsync" OnCancel="CloseOrdering" />
        }
        @if (reviewing)
        {
            <section class="call-review" role="dialog" aria-modal="true" aria-labelledby="call-review-heading">
                <h2 id="call-review-heading">@(Editing ? "Save changes?" : "Save this call?")</h2>
                <p class="call-summary">@draft.Content.Summary</p>
                <div class="order-actions">
                    <button type="button" class="secondary" disabled="@busy" @onclick="() => reviewing = false">Back</button>
                    <button type="button" class="primary" disabled="@busy" @onclick="SaveAsync">Save</button>
                </div>
            </section>
        }
        @if (leaving)
        {
            <section class="order-confirm" role="alertdialog" aria-labelledby="call-leave-question">
                <p id="call-leave-question" class="confirm-question"><strong>@(Editing ? "Leave without saving these changes?" : "Leave without saving this call?")</strong></p>
                @if (draft.AddedToOrder) { <p>Lines added to the order stay on it.</p> }
                <div class="order-actions">
                    <button type="button" class="danger" @onclick="Leave">Leave</button>
                    <button type="button" class="secondary" @onclick="() => leaving = false">Stay</button>
                </div>
            </section>
        }
        @if (!reviewing && !leaving)
        {
            <footer class="order-footer">
                <div class="order-actions">
                    @if (!Editing) { <button type="button" class="secondary" disabled="@busy" @onclick="OpenOrder">Open order</button> }
                    <button type="button" class="primary" disabled="@busy" @onclick="Review">Review and save</button>
                </div>
            </footer>
        }
    }
</section>

@code {
    [Parameter] public Guid Id { get; set; }
    /// <summary>The order whose Low tab opened this page (T-5.1.5 D5): saving links it to the Call, and Back returns to it.</summary>
    [Parameter] public Guid? OrderId { get; set; }
    /// <summary>The saved Call Edit Call corrects (T-5.6.1); absent when recording a new Call.</summary>
    [Parameter] public Guid? CallId { get; set; }

    private bool Editing => CallId is not null;
    // T-5.6.1: the saved Call as it was, what it recorded (which lines had a count, whether it had notes) and whether it can change.
    private TabletCall? original;
    private HashSet<Guid> countedBefore = [];
    private bool hadNotes;

    private string? rep;
    private OfflineLocationDetail? detail;
    private StockCheckStart start = StockCheckStart.Empty;
    private bool adding;
    private string query = "";
    private string filter = "";
    private ProductSearchOutcome filterFound = new([], 0);
    private int filterRevision;
    private ProductSearchOutcome found = new([], 0);
    private int searchRevision;
    private readonly HashSet<Guid> expanded = [];
    private string? problem;
    private CallDraft draft = New();
    private string? message;
    private bool reviewing;
    private bool leaving;
    private bool busy;
    // T-5.5.1: the shop's order this Call adds to (null until there is one), and the product whose quantity popover is open.
    private TabletOrder? callOrder;
    private ProductSearchResult? ordering;
    private string? orderError;

    private static CallDraft New() => new(Guid.NewGuid(), null, "", false);

    // Back returns to the shop, or to the order this page was opened from; an order with no lines yet isn't saved, so a new one.
    private string BackLabel => Editing ? "Back to call" : OrderId is null ? "Back to shop" : "Back to order";

    private string BackHref => Editing ? $"/locations/{Id}/calls/{CallId}" : OrderId is not { } from ? $"/locations/{Id}"
        : callOrder?.Id == from ? $"/locations/{Id}/orders/{from}" : $"/locations/{Id}/orders/new";

    protected override void Clear()
    {
        rep = null; detail = null; problem = null; draft = New(); message = null; reviewing = false; leaving = false;
        start = StockCheckStart.Empty; CloseAdding(); filter = ""; filterFound = new([], 0); ++filterRevision;
        callOrder = null; ordering = null; orderError = null; original = null; countedBefore = []; hadNotes = false;
    }

    protected override async Task ReadAsync(string repSubject, Func<bool> isCurrent)
    {
        if (CallId is Guid editing) { await ReadEditAsync(repSubject, isCurrent, editing); return; }
        Guid shop = Id;
        Guid? orderFrom = OrderId;
        try
        {
            // A resume rebuilds this page; the Call being recorded comes back, with the same id and its stock rows.
            CallDraft restored = Tablet.CallDrafts.Read(repSubject, Tablet.SessionVersion, shop) ?? New();
            OfflineLocationDetail? read = null;
            StockCheckStart readStart = StockCheckStart.Empty;
            TabletOrder? readOrder = null;
            await Task.Run(() =>
            {
                read = Tablet.ReadLocation(repSubject, shop);
                if (read is not { IsAssigned: true }) return;
                readStart = Tablet.ReadStockCheckStart(repSubject, shop);
                // Opened from an order's Low tab, the Call adds to that order (T-5.1.5); otherwise to the one T-5.5.1 picks.
                readOrder = orderFrom is { } from
                    ? Tablet.ReadOrder(repSubject, from) is { } opened && opened.LocationId == shop ? opened : null
                    : Tablet.ReadCallOrder(repSubject, restored.CallId, shop);
            });
            if (!isCurrent()) return;
            rep = repSubject; detail = read; start = readStart; callOrder = readOrder;
            draft = restored;
            if (draft.Stock is null)
                draft = draft with { Stock = [.. start.Suggested.Select(row => new StockLine(row.Product, row.Sources))] };
        }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (isCurrent()) problem = "Shop details couldn't be opened. Your saved work is still on this tablet.";
        }
    }

    // T-5.6.1: Edit Call opens the saved Call (or the correction kept across a resume). Only an unsent Call no upload has claimed can
    // change (D5); a correction is judged as captured, so the shop needn't still be assigned.
    private async Task ReadEditAsync(string repSubject, Func<bool> isCurrent, Guid callId)
    {
        Guid shop = Id;
        try
        {
            OfflineLocationDetail? read = null;
            CallView? saved = null;
            ProductSearchIndex? products = null;
            await Task.Run(() =>
            {
                read = Tablet.ReadLocation(repSubject, shop);
                saved = Tablet.ReadCallView(repSubject, callId);
                products = Tablet.ReadProductIndex(repSubject);
            });
            if (!isCurrent()) return;
            rep = repSubject; detail = read;
            if (saved is null || saved.Call.LocationId != shop) return;
            if (!saved.CanCorrect)
            {
                problem = saved.Standing switch
                {
                    CallStanding.Sending => CallStore.BeingSent,
                    CallStanding.Sent => CallStore.AlreadySent,
                    _ => CallStore.NotCorrectable
                };
                return;
            }
            original = saved.Call;
            countedBefore = [.. (original.StockEntries ?? []).Where(entry => entry.Count is not null).Select(entry => entry.ProductId)];
            hadNotes = original.PitchNotes is not null;
            draft = Tablet.CallDrafts.ReadEdit(repSubject, Tablet.SessionVersion, callId) ?? FromCall(original, products!);
        }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (isCurrent()) problem = "This call couldn't be opened. Your saved work is still on this tablet.";
        }
    }

    private void Change(CallDraft changed)
    {
        draft = changed;
        message = null;
        if (rep is null) return;
        if (Editing) Tablet.CallDrafts.KeepEdit(rep, Tablet.SessionVersion, draft);
        else Tablet.CallDrafts.Keep(rep, Tablet.SessionVersion, Id, draft);
    }

    private void Choose(CallChannel channel) { if (!busy) Change(draft with { Channel = channel }); }

    private void ToggleNotes() => Change(draft with { NotesOpen = !draft.NotesOpen });

    private void NotesChanged(ChangeEventArgs args) => Change(draft with { Notes = args.Value?.ToString() ?? "" });

    // S4 and S5: what is missing is said on the page, and the review only opens for a Call that can be saved.
    private void Review()
    {
        if (busy) return;
        message = (Editing ? Uncounted : null) ?? draft.Problem;
        reviewing = message is null;
    }

    private async Task SaveAsync()
    {
        if (busy || rep is null) return;
        busy = true;
        string repSubject = rep;
        Guid shop = Id;
        CallDraft saving = draft;
        Guid? orderFrom = OrderId;
        bool editing = Editing;
        long version = Tablet.SessionVersion;
        try
        {
            OrderResult? link = null;
            CallResult result = await Task.Run(() =>
            {
                if (editing) return Tablet.CorrectCall(repSubject, saving.CallId, shop, saving.Content);
                CallResult saved = Tablet.SaveCall(repSubject, saving.CallId, shop, saving.Content);
                // T-5.1.5 D5: the order whose Low tab opened this Call is linked to it once the Call is saved.
                if (saved.Succeeded && orderFrom is { } from) link = Tablet.LinkOrderToCall(repSubject, from, saving.CallId);
                return saved;
            });
            if (version != Tablet.SessionVersion || shop != Id) return;
            if (result.Succeeded && editing)
            {
                Tablet.CallDrafts.Corrected(repSubject, version, saving.CallId);
                Navigation.NavigateTo($"/locations/{shop}/calls/{saving.CallId}");
                return;
            }
            if (result.Succeeded)
            {
                Tablet.CallDrafts.Saved(repSubject, version, shop);
                // Back to order entry, now for this Call: on the linked order, else a new order opened from the Call (the order had
                // no lines yet), else the order as it was if it could no longer be linked.
                Navigation.NavigateTo(orderFrom is not { } order ? $"/locations/{shop}"
                    : link is { Succeeded: true } ? $"/locations/{shop}/calls/{saving.CallId}/orders/{order}"
                    : link?.Error == OrderStore.NotFound ? $"/locations/{shop}/calls/{saving.CallId}/orders/new"
                    : $"/locations/{shop}/orders/{order}");
                return;
            }
            reviewing = false;
            message = result.Error;
        }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (version == Tablet.SessionVersion) { reviewing = false; message = "That couldn't be saved. Your call is still here. Try again."; }
        }
        finally { busy = false; }
    }

    /// <summary>T-06's stock section. In person, the stock check: the Suggested List as rows with their source, a count (blank
    /// is Not checked), remove, and Add product by search or by category. On Phone, "Stock mentioned": the same rows with Low,
    /// Out, Add to order (with ordering from a call) and Add count, narrowed by one "Filter or search" box.</summary>
    private RenderFragment StockCheck => @<section class="call-section stock-check" aria-labelledby="stock-check-heading">
        <header class="stock-check-header">
            <h2 id="stock-check-heading" class="call-section-heading">@(draft.Mentioning ? "Stock mentioned" : "Stock check")</h2>
            @if (draft.StockSummary.Length > 0) { <span class="stock-summary">@draft.StockSummary</span> }
            @if (Editing) { @FollowUp }
            else if (!draft.Mentioning)
            {
                <button type="button" class="secondary" aria-expanded="@(adding ? "true" : "false")" disabled="@busy"
                        @onclick="ToggleAdding">Add product</button>
            }
        </header>
        @if (adding && !draft.Mentioning && !Editing) { @AddProduct }
        @if (draft.Mentioning) { @FilterOrSearch }
        @if (draft.Lines.Count == 0) { <p class="stock-empty">@SuggestedList.Empty</p> }
        else if (Shown.Count > 0)
        {
            <ul class="stock-lines">
                @foreach (StockLine line in Shown)
                {
                    <li class="stock-line" @key="line.Product.Id">
                        <div class="stock-line-text">
                            <strong>@line.Product.Name</strong>
                            @if (line.Label.Length > 0) { <span class="stock-source">@line.Label</span> }
                        </div>
                        @if (draft.Mentioning) { @Mentioned(line) }
                        else
                        {
                        <div class="stock-count">
                            @if (Editing && !countedBefore.Contains(line.Product.Id))
                            {
                                <span class="stock-not-checked">not checked</span>
                            }
                            else
                            {
                            <button type="button" class="stepper" aria-label="@($"Less {line.Product.Name}")" disabled="@busy"
                                    @onclick="() => Step(line, -1)">−</button>
                            <input id="@($"count-{line.Product.Id}")" class="count-input" inputmode="decimal" autocomplete="off"
                                   aria-label="@($"Count for {line.Product.Name}")" placeholder="not checked" value="@line.Count"
                                   disabled="@busy" @oninput="args => Count(line, args)" />
                            <button type="button" class="stepper" aria-label="@($"More {line.Product.Name}")" disabled="@busy"
                                    @onclick="() => Step(line, 1)">+</button>
                            @if (line.Product.Unit != "Each") { <span class="count-unit">@line.Product.Unit</span> }
                            }
                            <button type="button" class="secondary stock-remove" aria-label="@($"Remove {line.Product.Name}")"
                                    disabled="@busy" @onclick="() => Remove(line)">Remove</button>
                        </div>
                        <div class="stock-marks">
                            <button type="button" class="mark-option" aria-pressed="@(line.Low ? "true" : "false")"
                                    aria-label="@($"Low {line.Product.Name}")" disabled="@busy"
                                    @onclick="() => ChangeLine(line, row => row.Tick())">Low</button>
                            @if (line.Low && !Editing) { @ToOrder(line) }
                        </div>
                        }
                        @if (line.Problem is { } countProblem) { <p class="problem" role="alert">@countProblem</p> }
                    </li>
                }
            </ul>
        }
    </section>;

    /// <summary>The rows on screen: on Phone, those the filter leaves; In person, all of them.</summary>
    private IReadOnlyList<StockLine> Shown => draft.Mentioning ? draft.Filtered(filter) : draft.Lines;

    /// <summary>Phone's one box (S9, D7): it narrows the rows by name or code, and when nothing on the list matches it offers
    /// the downloaded catalogue, where Add makes the product a row.</summary>
    private RenderFragment FilterOrSearch => @<div class="stock-filter">
        <div class="search-field">
            <label for="stock-filter">Filter or search</label>
            <input id="stock-filter" type="search" value="@filter" @oninput="FilterAsync" autocomplete="off" disabled="@busy" />
        </div>
        @if (Editing && !string.IsNullOrWhiteSpace(filter) && Shown.Count == 0)
        {
            <p role="status">Nothing on this call matches '@filter.Trim()'</p>
        }
        else if (!string.IsNullOrWhiteSpace(filter) && Shown.Count == 0)
        {
            <div role="status" aria-live="polite">
                @if (filterFound.Total == 0) { <p>No products match '@filter.Trim()'</p> }
                else
                {
                    <p>Nothing on the list matches '@filter.Trim()'. From the catalogue:</p>
                    @if (filterFound.Total > filterFound.Results.Count) { <p>Showing @filterFound.Results.Count of @filterFound.Total matching products. Keep typing to narrow the list.</p> }
                }
            </div>
            <ul class="product-results">
                @foreach (ProductSearchResult product in filterFound.Results) { @AddRow(product) }
            </ul>
        }
    </div>;

    /// <summary>A phone row (S8): Low and Out as toggles, Add to order on every row (T-5.5.1 D4, without marking Low), and a
    /// count only after Add count, with no stepper (D6).</summary>
    private RenderFragment Mentioned(StockLine line) => @<div class="stock-marks">
        <button type="button" class="mark-option" aria-pressed="@(line.Low ? "true" : "false")" aria-label="@($"Low {line.Product.Name}")"
                disabled="@busy" @onclick="() => ChangeLine(line, row => row.ToggleLow())">Low</button>
        @if (!Editing || countedBefore.Contains(line.Product.Id))
        {
        <button type="button" class="mark-option" aria-pressed="@(line.Out ? "true" : "false")" aria-label="@($"Out {line.Product.Name}")"
                disabled="@busy" @onclick="() => ChangeLine(line, row => row.ToggleOut())">Out</button>
        }
        @if (!Editing) { @ToOrder(line) }
        @if (Editing ? countedBefore.Contains(line.Product.Id) : line.CountShown)
        {
            <input id="@($"count-{line.Product.Id}")" class="count-input" inputmode="decimal" autocomplete="off"
                   aria-label="@($"Count for {line.Product.Name}")" placeholder="count" value="@line.Count"
                   disabled="@busy" @oninput="args => Count(line, args)" />
            @if (line.Product.Unit != "Each") { <span class="count-unit">@line.Product.Unit</span> }
        }
        else
        {
            @if (!Editing)
            {
            <button type="button" class="secondary" aria-label="@($"Add count for {line.Product.Name}")" disabled="@busy"
                    @onclick="() => ChangeLine(line, row => row.OpenCount())">Add count</button>
            }
        }
        @if (Editing)
        {
            <button type="button" class="secondary stock-remove" aria-label="@($"Remove {line.Product.Name}")"
                    disabled="@busy" @onclick="() => Remove(line)">Remove</button>
        }
    </div>;

    /// <summary>Add to order (T-5.5.1): In person on a Low row, on Phone on every row. It opens the quantity popover. Once the
    /// product is on the Call's order, however it got there, the row says "On order (24)" instead (S3, D5).</summary>
    private RenderFragment ToOrder(StockLine line) => @<text>
        @if (OnOrder(line.Product) is { } quantity) { <span class="stock-on-order">On order (@quantity)</span> }
        else
        {
            <button type="button" class="secondary" aria-label="@($"Add {line.Product.Name} to order")" disabled="@busy"
                    @onclick="() => OpenOrdering(line)">Add to order</button>
        }
    </text>;

    /// <summary>The product's quantity on the Call's order as the rep reads it, "24" or "2.5 kg"; null when it isn't on it.</summary>
    private string? OnOrder(ProductSearchResult product) =>
        callOrder?.Lines.FirstOrDefault(line => line.ProductId == product.Id) is { } line
            ? line.Quantity.ToString(line.Unit == "Each" ? "0" : "0.0#####", System.Globalization.CultureInfo.InvariantCulture)
                + (line.Unit == "Each" ? "" : $" {line.Unit}")
            : null;

    /// <summary>Search the downloaded catalogue, or browse it by category when nothing is typed (S3).</summary>
    private RenderFragment AddProduct => @<div class="stock-add">
        <div class="search-field">
            <label for="stock-search">Find a product</label>
            <input id="stock-search" type="search" value="@query" @oninput="SearchAsync" autocomplete="off" />
        </div>
        @if (!string.IsNullOrWhiteSpace(query))
        {
            <div role="status" aria-live="polite">
                @if (found.Total == 0) { <p>No products match '@query.Trim()'</p> }
                else if (found.Total > found.Results.Count) { <p>Showing @found.Results.Count of @found.Total matching products. Keep typing to narrow the list.</p> }
            </div>
            <ul class="product-results">
                @foreach (ProductSearchResult product in found.Results) { @AddRow(product) }
            </ul>
        }
        else
        {
            <section class="order-pad" aria-label="Browse by category">
                @if (start.Products.Pad.Categories.Count == 0) { <p>No products in your downloaded day.</p> }
                @foreach (OrderPadCategory category in start.Products.Pad.Categories) { @Browse(category) }
            </section>
        }
    </div>;

    private RenderFragment Browse(OrderPadCategory category) => @<section class="pad-category" @key="category.Id">
        <h3 class="pad-heading">
            <button type="button" class="pad-header" aria-expanded="@(expanded.Contains(category.Id) ? "true" : "false")"
                    @onclick="() => Expand(category.Id)">
                <span class="pad-breadcrumb">@category.Breadcrumb</span>
                <span class="pad-count">@category.Beneath @(category.Beneath == 1 ? "product" : "products")</span>
            </button>
        </h3>
        @if (expanded.Contains(category.Id))
        {
            <div class="pad-body">
                @foreach (OrderPadCategory subcategory in category.Subcategories) { @Browse(subcategory) }
                @if (category.Here > 0)
                {
                    <ul class="pad-products">
                        @foreach (ProductSearchResult product in category.Products) { @AddRow(product) }
                    </ul>
                }
            </div>
        }
    </section>;

    private RenderFragment AddRow(ProductSearchResult product) => @<li class="pad-product" @key="product.Id">
        <div class="pad-product-text">
            <strong>@product.Name</strong>
            <span>@product.Code · @product.Breadcrumb</span>
        </div>
        @if (draft.Lines.Any(line => line.Product.Id == product.Id)) { <span class="pad-on-order">On the list</span> }
        else
        {
            <button type="button" class="secondary pad-add" aria-label="@($"Add {product.Name}")" @onclick="() => Add(product)">Add</button>
        }
    </li>;

    private void ChangeStock(Func<IReadOnlyList<StockLine>, IEnumerable<StockLine>> change, bool rows) =>
        Change(draft with { Stock = [.. change(draft.Lines)], StockChanged = draft.StockChanged || rows });

    private void ChangeLine(StockLine line, Func<StockLine, StockLine> change)
    {
        if (busy) return;
        ChangeStock(lines => lines.Select(row => row.Product.Id == line.Product.Id ? change(row) : row), false);
    }

    private void Count(StockLine line, ChangeEventArgs args) => ChangeLine(line, row => row with { Count = args.Value?.ToString() ?? "" });

    private void Step(StockLine line, int direction) => ChangeLine(line, row => row.Step(direction));

    private void Remove(StockLine line)
    {
        if (busy) return;
        ChangeStock(lines => lines.Where(row => row.Product.Id != line.Product.Id), true);
    }

    // Added rows join the list in name order, like the suggested ones (WI-049 D8). On Phone the filter stays, so the added row is
    // what it shows, ready to mark.
    private void Add(ProductSearchResult product)
    {
        if (busy || draft.Lines.Any(line => line.Product.Id == product.Id)) return;
        ChangeStock(lines => lines.Append(new StockLine(product, SuggestionSources.None))
            .OrderBy(line => line.Product.Name, StringComparer.CurrentCultureIgnoreCase).ThenBy(line => line.Product.Id), true);
        CloseAdding();
    }

    private void ToggleAdding()
    {
        if (adding) CloseAdding();
        else adding = true;
    }

    private void CloseAdding()
    {
        adding = false; query = ""; found = new([], 0); ++searchRevision; expanded.Clear();
    }

    private void Expand(Guid category) { if (!expanded.Remove(category)) expanded.Add(category); }

    // The rows are filtered as typed; the catalogue is searched off the UI thread only when no row matches.
    private async Task FilterAsync(ChangeEventArgs args)
    {
        int current = ++filterRevision;
        filter = args.Value?.ToString() ?? "";
        filterFound = new([], 0);
        if (string.IsNullOrWhiteSpace(filter) || draft.Filtered(filter).Count > 0) return;
        string text = filter;
        ProductSearchIndex products = start.Products;
        ProductSearchOutcome outcome = await Task.Run(() => products.Search(text));
        if (current == filterRevision) filterFound = outcome;
    }

    private async Task SearchAsync(ChangeEventArgs args)
    {
        int current = ++searchRevision;
        query = args.Value?.ToString() ?? "";
        string text = query;
        ProductSearchIndex products = start.Products;
        ProductSearchOutcome outcome = await Task.Run(() => products.Search(text));
        if (current == searchRevision) found = outcome;
    }


    // The popover opens with an empty quantity each time (T7.7); opening another row's replaces it.
    private void OpenOrdering(StockLine line)
    {
        if (busy) return;
        ordering = line.Product; orderError = null;
    }

    private void CloseOrdering()
    {
        if (busy) return;
        ordering = null; orderError = null;
    }

    /// <summary>"counted 3" (with the unit for a measured product) or "not counted", from the row as it is now.</summary>
    private string Recorded(ProductSearchResult product) =>
        draft.Lines.FirstOrDefault(line => line.Product.Id == product.Id) is { Counted: true } line
            ? $"counted {line.Count.Trim()}{(product.Unit == "Each" ? "" : $" {product.Unit}")}" : "not counted";

    // The store finds this Call's order or starts one, under the order gate (D2); the popover closes on add.
    private async Task AddToOrderAsync(decimal quantity)
    {
        if (busy || rep is null || ordering is not { } product) return;
        busy = true;
        orderError = null;
        string repSubject = rep;
        Guid shop = Id, call = draft.CallId;
        long version = Tablet.SessionVersion;
        try
        {
            Guid? orderFrom = OrderId;
            OrderResult result = await Task.Run(() => orderFrom is { } from
                ? Tablet.AddOrderLineForCall(repSubject, from, shop, product.Id, quantity, call)
                : Tablet.AddOrderLineFromCall(repSubject, call, shop, product.Id, quantity));
            if (version != Tablet.SessionVersion || shop != Id) return;
            if (result.Succeeded)
            {
                callOrder = result.Order;
                ordering = null;
                Change(draft with { AddedToOrder = true });
            }
            else orderError = result.Error;
        }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (version == Tablet.SessionVersion) orderError = "That couldn't be added. Try again.";
        }
        finally { busy = false; }
    }

    // T-5.1.4 D2: order entry for this Call's order (or a new one linked to it on its first line), with its Low tab. The draft is
    // kept first, so Back to call finds the same Call even if nothing was entered yet.
    private void OpenOrder()
    {
        if (busy || rep is null) return;
        Tablet.CallDrafts.Keep(rep, Tablet.SessionVersion, Id, draft);
        Navigation.NavigateTo(callOrder is { } order
            ? $"/locations/{Id}/calls/{draft.CallId}/orders/{order.Id}"
            : $"/locations/{Id}/calls/{draft.CallId}/orders/new");
    }

    private void BackToShop()
    {
        if (busy) return;
        if (Editing ? !Unchanged : draft.HasWork) { leaving = true; reviewing = false; return; }
        Leave();
    }

    private void Leave()
    {
        if (rep is not null)
        {
            if (Editing) Tablet.CallDrafts.KeepEdit(rep, Tablet.SessionVersion, null);
            else Tablet.CallDrafts.Keep(rep, Tablet.SessionVersion, Id, null);
        }
        Navigation.NavigateTo(BackHref);
    }

    // T-5.6.1 (D3): until WI-056 links it, the follow-up is a new Call at the shop.
    private RenderFragment FollowUp => @<button type="button" class="secondary" disabled="@busy"
        @onclick="@(() => Navigation.NavigateTo($"/locations/{Id}/calls/new"))">Record a follow-up call</button>;

    /// <summary>T-5.6.1: the saved Call as Edit Call starts it — its channel, notes and lines, each with what it recorded.</summary>
    private static CallDraft FromCall(TabletCall call, ProductSearchIndex products) => new(call.Id, call.Channel, call.PitchNotes ?? "",
        call.PitchNotes is not null,
        [.. (call.StockEntries ?? []).Select(entry => new StockLine(
            products.Find(entry.ProductId) ?? new ProductSearchResult(entry.ProductId, entry.ProductCode, entry.ProductName, "", entry.Unit, null),
            SuggestionSources.None,
            entry.Count?.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture) ?? "", entry.Low))]);

    /// <summary>A correction can't clear a count (D2): Remove drops the line instead.</summary>
    private string? Uncounted => draft.Saved.FirstOrDefault(line => countedBefore.Contains(line.Product.Id) && !line.Counted) is { } line
        ? $"Enter a count for {line.Product.Name}, or remove it." : null;

    /// <summary>Whether Edit Call still holds what the Call recorded, so Back needn't ask.</summary>
    private bool Unchanged => original is { } call && draft.Channel == call.Channel
        && draft.Content.Notes == call.PitchNotes
        && draft.Saved.Select(line => (line.Product.Id, line.Entry.Count, line.Low))
            .SequenceEqual((call.StockEntries ?? []).Select(entry => (entry.ProductId, entry.Count, entry.Low)));
}
