@page "/"
@implements IDisposable
@inject TabletApp Tablet
@inject NavigationManager Navigation

@* I-03 · Tablet entry and return. The locked states never show a rep's name, Locations or work. *@
<section class="entry">
    <h1>Sign in on this tablet</h1>
    @if (entry is null)
    {
        <p>Opening your day…</p>
    }
    else
    {
        <p class="lead">@entry.Message</p>
        @if (entry.Screen == EntryScreen.SignIn)
        {
            <button class="primary" disabled="@busy" @onclick="SignInAsync">Continue to staff sign-in</button>
        }
        else
        {
            <button class="secondary" disabled="@busy" @onclick="RefreshAsync">Try again</button>
        }
        @if (problem is not null)
        {
            <p class="problem" role="alert">@problem</p>
        }
    }
</section>

@code {
    private TabletEntry? entry;
    private string? problem;
    private bool busy;
    private int load;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        TabletTiming.Mark("entry");
        Tablet.Resumed += OnResumed;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        int current = ++load;
        TabletEntry next = await Tablet.EnterAsync();
        if (disposed || current != load || next.SessionVersion != Tablet.SessionVersion) return;
        entry = next;
        TabletTiming.Mark("checked");
        if (entry.Screen is EntryScreen.Home or EntryScreen.Sync)
        {
            // The next screen opens straight from this check, so it need not repeat it.
            Tablet.HandOff(entry);
            Navigation.NavigateTo(entry.Screen == EntryScreen.Home ? "/home" : "/sync");
        }
    }

    private async Task SignInAsync()
    {
        busy = true;
        problem = (await Tablet.SignInAsync()).Problem;
        if (disposed) return;
        busy = false;
        await RefreshAsync();
    }

    private void OnResumed() => _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    public void Dispose() { disposed = true; ++load; Tablet.Resumed -= OnResumed; }
}
