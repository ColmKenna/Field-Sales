@page "/locations/{LocationId:guid}/orders/new"
@page "/locations/{LocationId:guid}/orders/{OrderId:guid}"
@page "/locations/{LocationId:guid}/calls/{CallId:guid}/orders/new"
@page "/locations/{LocationId:guid}/calls/{CallId:guid}/orders/{OrderId:guid}"
@inherits OfflineCataloguePage
@using System.Diagnostics
@using System.Globalization
@using FieldSales.Calls.Contracts
@using FieldSales.Ordering.Contracts
@using FieldSales.Quantities
@using FieldSales.Tablet.Components.Shared
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@inject IServiceProvider Services

@* T-07 · Order entry: the Order Pad by category (T7.3) and search, and the Low tab (T-5.1.4, T7.1). Review comes later.
   T-5.2.1: the same screen opens a saved order by id; OrderTransitions decides which controls its standing gets.
   T-5.1.4: opened from Record call (the calls/{CallId} routes) it adds for that Call and goes back to it.
   T-5.1.5: an order with no Call carries the gaps the shop's last Call left, and Record call links the order to a new one. *@
<section class="new-order">
    <nav class="shop-back" aria-label="Order navigation"><a href="@BackHref">@(CallId is null ? "Back to shop" : "Back to call")</a></nav>
    @if (!Ready) { <h1>@Heading</h1><p role="status">Opening order…</p> }
    else if (problem is not null) { <h1>@Heading unavailable</h1><p role="alert">@problem</p> }
    else if (OrderId is null && detail is not { IsAssigned: true }) { <h1>New order unavailable</h1><p role="alert">@OrderStore.NotAssigned</p> }
    else if (OrderId is not null && order is null) { <h1>Order unavailable</h1><p role="alert">@OrderStore.NotFound</p> }
    else
    {
        <header class="order-header">
            <h1>@Heading</h1>
            <p class="order-shop">@(detail?.Location.Name ?? "Shop details unavailable")</p>
        </header>
        @if (StatusNotice is { } notice)
        {
            <p class="ready-notice" role="status">@notice</p>
        }
        @if (CanAdd)
        {
            @* T7.1: the Low list is a tab, its count always in view. "Search all" joins when Ranges split the pad from the catalogue. *@
            <div class="order-tabs" role="tablist" aria-label="Order entry">
                <button type="button" role="tab" aria-selected="@(lowTab ? "false" : "true")" @onclick="ShowPad">Order pad</button>
                <button type="button" role="tab" aria-selected="@(lowTab ? "true" : "false")" @onclick="ShowLow">Low (@Low.Outstanding)</button>
            </div>
        }
        @if (CanAdd && lowTab) { @LowTab }
        else
        {
            @if (CanAdd)
            {
                <div class="search-field">
                    <label for="product-search">Find a product</label>
                    <input id="product-search" type="search" value="@query" @oninput="SearchAsync" autocomplete="off" />
                </div>
            }
            @if (CanAdd && !string.IsNullOrWhiteSpace(query))
            {
                <div role="status" aria-live="polite">
                    @if (results.Total == 0) { <p>No products match '@query.Trim()'</p> }
                    else if (results.Total > results.Results.Count) { <p>Showing @results.Results.Count of @results.Total matching products. Keep typing to narrow the list.</p> }
                    else { <p>@results.Total matching @(results.Total == 1 ? "product" : "products")</p> }
                </div>
                <ul class="product-results">
                    @foreach (ProductSearchResult product in results.Results)
                    {
                        <li @key="product.Id">
                            <button type="button" class="product-result" @onclick="() => Select(product)">
                                <strong>@product.Name</strong>
                                <span>@product.Code · @product.Breadcrumb</span>
                                <span class="product-price">@(product.Price is decimal price ? Money(price) + PerUnit(product.Unit) : "No price yet")</span>
                            </button>
                        </li>
                    }
                </ul>
                @if (selected is not null) { @AddLine }
            }
            else if (CanAdd && index is not null)
            {
                <section class="order-pad" aria-label="Order pad">
                    @if (index.Pad.Categories.Count == 0) { <p>No products in your downloaded day.</p> }
                    @foreach (OrderPadCategory category in index.Pad.Categories) { @PadSection(category) }
                </section>
            }
        }
        @if (lowProduct is { } adding && lowEntry is { } marked)
        {
            <QuantityPopover @key="adding.Id" Product="adding" Recorded="@(lowRecorded ?? LowItem.Recorded(marked))" Busy="busy" Error="@lowError"
                             OnAdd="AddLowAsync" OnCancel="CloseLow" />
        }
        <section class="order-lines" aria-labelledby="order-lines-heading">
            <h2 id="order-lines-heading">On this order</h2>
            @if (order is null || order.Lines.Count == 0) { <p>No products yet.</p> }
            else
            {
                <ul>
                    @foreach (OrderLine line in order.Lines)
                    {
                        <li @key="line.Id">
                            <strong>@line.ProductName</strong>
                            <span>@line.ProductCode</span>
                            <span class="line-quantity">@LineQuantity(line)</span>
                            <span class="line-price">@Money(line.Price.Amount)@PerUnit(line.Unit)</span>
                            <span class="line-total">@Money(line.Price.Amount * line.Quantity)</span>
                            @if (index is not null && !index.Contains(line.ProductId))
                            { <span class="captured-line-notice">@OrderStore.NoLongerAvailable</span> }
                            @if (editingLine == line.Id) { @ChangeLine(line) }
                            else if (CanChangeLines && confirm is null)
                            {
                                <div class="line-actions">
                                    <button type="button" class="secondary" aria-label="@($"Change {line.ProductName}")" disabled="@busy"
                                            @onclick="() => StartChange(line)">Change</button>
                                    <button type="button" class="secondary" aria-label="@($"Remove {line.ProductName}")" disabled="@busy"
                                            @onclick="() => RemoveAsync(line)">Remove</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
        @if (confirm is { } ask)
        {
            <section class="order-confirm" role="alertdialog" aria-labelledby="order-confirm-question">
                <p id="order-confirm-question" class="confirm-question"><strong>@ask.Question</strong></p>
                <div class="order-actions">
                    <button type="button" class="danger" disabled="@busy" @onclick="ConfirmAsync">@ask.Yes</button>
                    <button type="button" class="secondary" disabled="@busy" @onclick="() => confirm = null">@ask.No</button>
                </div>
            </section>
        }
        <footer class="order-footer">
            <p class="order-summary" role="status">@Summary</p>
            @if (readyError is not null) { <p class="problem" role="alert">@readyError</p> }
            @if (confirm is null)
            {
                <div class="order-actions">
                    <button type="button" class="secondary" @onclick="SaveAndClose">@(CanEdit ? "Save and close" : "Close")</button>
                    @if (CanEdit) { <button type="button" class="primary" disabled="@busy" @onclick="MarkReadyAsync">Mark Ready to Send</button> }
                    @if (Standing == OrderStanding.ReadyToSend)
                    { <button type="button" class="primary" disabled="@busy" @onclick="ReopenAsync">Reopen</button> }
                    @if (CanChangeLines || Standing == OrderStanding.ReadyToSend)
                    { <button type="button" class="danger" disabled="@busy" @onclick="AskDelete">Delete order</button> }
                </div>
            }
        </footer>
    }
</section>

@code {
    [Parameter] public Guid LocationId { get; set; }
    /// <summary>A saved order to open (T-5.2.1). Absent on the New Order route.</summary>
    [Parameter] public Guid? OrderId { get; set; }
    /// <summary>The Call order entry was opened from (T-5.1.4 D2): lines link a new order to it, and Back returns to it.</summary>
    [Parameter] public Guid? CallId { get; set; }

    private const string SaveFailed = "That couldn't be saved. Your saved work is still on this tablet. Try again.";

    // One order for the whole screen: the id is chosen here, so repeating an add can never start a second order.
    private Guid orderId = Guid.NewGuid();
    private Guid orderShop;
    private Guid? openedOrder;
    // The standing last read from the tablet; Sending, Sent and Needs Attention can only change by reading again.
    private OrderStanding readStanding = OrderStanding.New;
    private DateTimeOffset? sentUtc;
    private Guid? editingLine;
    private string editText = "";
    private string? lineError;
    private Confirmation? confirm;
    private string? rep;
    private OfflineLocationDetail? detail;
    private ProductSearchIndex? index;
    private TabletOrder? order;
    private string? problem;
    private string query = "";
    private ProductSearchOutcome results = new([], 0);
    private int revision;
    private ProductSearchResult? selected;
    private string quantityText = "";
    private string? addError;
    private string? readyError;
    private bool busy;
    // Expanded Order Pad headers (D2: top-level categories start collapsed). Kept through search and adds; reset with the screen.
    private readonly HashSet<Guid> expanded = [];
    private long? searchStarted;
    private Guid? openedCall;
    // T-5.1.4: the Low tab, the saved Call it reads once that Call is no longer being recorded, and its open popover.
    private bool lowTab;
    private TabletCall? savedCall;
    private ProductSearchResult? lowProduct;
    private CallStockEntry? lowEntry;
    private string? lowError;
    private string? lowRecorded;
    // T-5.1.5: the shop's last Call gaps still open, read for an order with no Call.
    private CarriedLow? carried;

    private string Heading => OrderId is null ? "New order" : "Order";

    private string BackHref => CallId is null ? $"/locations/{LocationId}" : $"/locations/{LocationId}/calls/new";

    /// <summary>T-5.1.5 D5: Record call from the Low tab, for this order; saving the Call links the order to it.</summary>
    private string RecordCallHref => $"/locations/{LocationId}/orders/{orderId}/calls/new";

    /// <summary>The Call whose Low items the tab lists: the one order entry was opened from, else the one the order is linked to.</summary>
    private Guid? CallFor => CallId ?? order?.CallId;

    /// <summary>That Call's draft while it is being recorded at this shop (the Low marks as they are now, and what was taken off).</summary>
    private CallDraft? Draft => rep is not null && CallFor is { } call
        && Tablet.CallDrafts.Read(rep, Tablet.SessionVersion, LocationId) is { } draft && draft.CallId == call ? draft : null;

    /// <summary>Each Low item's state, worked out from the Call and the order as it is now (D5).</summary>
    private LowList Low => Draft is { } draft ? draft.Low(order)
        : savedCall is { } call && call.Id == CallFor ? LowItems.Of(call.StockEntries ?? [], order, [])
        : CallFor is null && carried is { } gaps ? LowItems.Carried(gaps, order) : LowList.None;

    private bool HasCall => Draft is not null || (savedCall is { } call && call.Id == CallFor);

    private OrderStanding Standing => readStanding is OrderStanding.Sending or OrderStanding.Sent or OrderStanding.NeedsAttention
        ? readStanding
        : order is null ? OrderStanding.New : order.State == OrderState.ReadyToSend ? OrderStanding.ReadyToSend : OrderStanding.InProgress;

    // Adding follows the current snapshot, so it needs the shop assigned; changing captured lines doesn't (D4).
    private bool CanEdit => Standing is OrderStanding.New or OrderStanding.InProgress;
    private bool CanAdd => CanEdit && detail is { IsAssigned: true };
    private bool CanChangeLines => Standing == OrderStanding.InProgress && order is { Lines.Count: > 0 };

    private string? StatusNotice => Standing switch
    {
        OrderStanding.ReadyToSend => "Ready to Send. It goes to head office at your next Sync.",
        OrderStanding.Sending => OrderStore.SendingUnconfirmed,
        OrderStanding.Sent => sentUtc is { } at
            ? $"Sent {at.ToLocalTime().ToString("d MMM HH:mm", CultureInfo.InvariantCulture)}. It can't be changed on this tablet."
            : "Sent. It can't be changed on this tablet.",
        OrderStanding.NeedsAttention => "This order needs attention. Review it from Sync.",
        OrderStanding.InProgress when detail is not { IsAssigned: true } =>
            $"{OrderStore.NotAssigned} You can change or remove its lines but not add products.",
        _ => null
    };

    /// <summary>A question the rep answers before an order goes: Delete order, or removing its last line (US-013 S3, S4).</summary>
    private sealed record Confirmation(string Question, string Yes, string No, Guid? LineId)
    {
        public static Confirmation DeleteOrder { get; } = new(OrderStore.DeletePrompt, "Delete order", "Keep order", null);
        public static Confirmation LastLine(Guid line) => new(OrderStore.LastLinePrompt, "Remove and delete", "Keep line", line);
    }

    /// <summary>Changing one line's quantity: the field opens with what is on the order; measured products keep their stepper.</summary>
    private RenderFragment ChangeLine(OrderLine line) => @<div class="change-line">
        <label for="edit-quantity">New quantity@(line.Unit == "Each" ? "" : $" ({line.Unit})")</label>
        <input id="edit-quantity" type="text" inputmode="decimal" value="@editText" @oninput="EditChanged" autocomplete="off"
               aria-describedby="@(lineError is null ? null : "edit-error")" />
        @if (line.Unit != "Each" && EditRules(line) is { } rules)
        {
            <div class="quantity-stepper" role="group" aria-label="New quantity controls">
                <button type="button" class="secondary" aria-label="Decrease new quantity" disabled="@(busy || EditStep(rules, false) is null)"
                        @onclick="() => StepEdit(rules, false)">−</button>
                <span>@line.Unit</span>
                <button type="button" class="secondary" aria-label="Increase new quantity" disabled="@(busy || EditStep(rules, true) is null)"
                        @onclick="() => StepEdit(rules, true)">+</button>
            </div>
        }
        <div class="order-actions">
            <button type="button" class="primary" disabled="@busy" @onclick="() => SaveChangeAsync(line)">Save</button>
            <button type="button" class="secondary" disabled="@busy" @onclick="CancelChange">Cancel</button>
        </div>
        @if (lineError is not null) { <p id="edit-error" class="problem" role="alert">@lineError</p> }
    </div>;

    /// <summary>One category header with the full breadcrumb (T7.3). Expanded: its subcategories first, then the products
    /// directly in it under "In {name} (n)" (the T-1.1.2 ordering).</summary>
    private RenderFragment PadSection(OrderPadCategory category) => @<section class="pad-category" @key="category.Id">
        <h2 class="pad-heading">
            <button type="button" class="pad-header" aria-expanded="@(expanded.Contains(category.Id) ? "true" : "false")"
                    aria-controls="@($"pad-{category.Id}")" @onclick="() => Toggle(category.Id)">
                <span class="pad-breadcrumb">@category.Breadcrumb</span>
                <span class="pad-count">@category.Beneath @(category.Beneath == 1 ? "product" : "products")</span>
            </button>
        </h2>
        @if (expanded.Contains(category.Id))
        {
            <div class="pad-body" id="@($"pad-{category.Id}")">
                @foreach (OrderPadCategory subcategory in category.Subcategories) { @PadSection(subcategory) }
                @if (category.Here > 0)
                {
                    <h3 class="pad-here">In @category.Name (@category.Here)</h3>
                    <ul class="pad-products">
                        @foreach (ProductSearchResult product in category.Products) { @PadRow(product) }
                    </ul>
                }
            </div>
        }
    </section>;

    /// <summary>A product on the pad: breadcrumb, today's price, what is already on the order, and Add (D3: no − until WI-046).</summary>
    private RenderFragment PadRow(ProductSearchResult product) => @<li class="pad-product" @key="product.Id">
        <div class="pad-product-text">
            <strong>@product.Name</strong>
            <span>@product.Code · @product.Breadcrumb</span>
            <span class="product-price">@(product.Price is decimal price ? Money(price) + PerUnit(product.Unit) : "No price yet")</span>
        </div>
        <div class="pad-product-quantity">
            @if (OnOrder(product.Id) is decimal quantity) { <span class="pad-on-order">@Quantity(quantity, product.Unit) on order</span> }
            <button type="button" class="secondary pad-add" aria-label="@($"Add {product.Name}")" disabled="@(product.Price is null)"
                    @onclick="() => Select(product)">Add</button>
        </div>
        @if (selected?.Id == product.Id) { @AddLine }
    </li>;

    /// <summary>WI-038's quantity entry for the selected product: under its pad row, or under the search results.</summary>
    private RenderFragment AddLine => @<text>
        @if (selected is { } chosen)
        {
            <section class="add-line" aria-labelledby="add-line-heading">
                <h2 id="add-line-heading">@chosen.Name</h2>
                <p class="add-line-detail">@chosen.Code · @chosen.Breadcrumb</p>
                @if (chosen.Price is decimal unitPrice) { <p class="add-line-price">@Money(unitPrice)@PerUnit(chosen.Unit)</p> }
                else { <p class="problem" role="status">No price yet — this product can't be ordered.</p> }
                <label for="line-quantity">Quantity@(chosen.Unit == "Each" ? "" : $" ({chosen.Unit})")</label>
                <input id="line-quantity" type="text" inputmode="decimal" value="@quantityText" @oninput="QuantityChanged"
                       disabled="@(chosen.Price is null)" autocomplete="off" aria-describedby="@(MeasureError is null ? null : "quantity-error")" />
                @if (chosen.Unit != "Each")
                {
                    <div class="quantity-stepper" role="group" aria-label="Quantity controls">
                        <button type="button" class="secondary" aria-label="Decrease quantity" disabled="@(!CanStep(false))" @onclick="() => StepQuantity(false)">−</button>
                        <span>@chosen.Unit</span>
                        <button type="button" class="secondary" aria-label="Increase quantity" disabled="@(!CanStep(true))" @onclick="() => StepQuantity(true)">+</button>
                    </div>
                }
                <button type="button" class="primary" disabled="@(busy || chosen.Price is null || (chosen.Unit != "Each" && !ValidMeasure))" @onclick="AddAsync">Add to order</button>
                @if (MeasureError is { } error) { <p id="quantity-error" class="problem" role="alert">@error</p> }
                @if (addError is not null) { <p class="problem" role="alert">@addError</p> }
            </section>
        }
    </text>;

    /// <summary>T-5.1.4's Low tab (T-07): each item marked Low on the Call with one state; Add on not added and REMOVED items
    /// opens the quantity popover. One row at a time: there is no Add all (T7.6).</summary>
    private RenderFragment LowTab => @<section class="low-tab" aria-label="Low items">
        @if (!HasCall)
        {
            @* T-5.1.5 (US-012 S19–S21): no Call with this order, so the gaps the shop's last Call left, if any are still open. *@
            <p class="low-empty">No stock check with this order.</p>
            @if (Low.CarriedFrom is { } from)
            {
                <p class="low-source">Still open from your call at @(detail?.Location.Name ?? "this shop") - @from.CalledOn.ToString("ddd d MMM", CultureInfo.InvariantCulture)</p>
                @LowRows
            }
            <a class="record-call" href="@RecordCallHref">Record call</a>
        }
        else if (Low.Items.Count == 0) { <p class="low-empty">Nothing marked Low on this call.</p> }
        else
        {
            <p class="low-source">From your stock check at @(detail?.Location.Name ?? "this shop")</p>
            @LowRows
        }
    </section>;

    private RenderFragment LowRows => @<text>
            <ul class="low-items">
                @foreach (LowItem item in Low.Items)
                {
                    <li class="low-item" @key="item.Entry.ProductId" data-low-item="@($"{item.Entry.ProductName}: {item.StateText}")">
                        <div class="low-item-text">
                            <strong>@item.Entry.ProductName</strong>
                            <span class="low-detail">@item.Detail</span>
                        </div>
                        <span class="@(item.State == LowItemState.NotAdded ? "low-state low-open" : "low-state")">@item.StateText</span>
                        @if (item.CanAdd && index?.Find(item.Entry.ProductId) is { } product)
                        {
                            <button type="button" class="secondary" aria-label="@($"Add {item.Entry.ProductName} to order")" disabled="@busy"
                                    @onclick="() => OpenLow(item, product)">Add</button>
                        }
                        else if (item.CanAdd) { <span class="captured-line-notice">@OrderStore.NoLongerAvailable</span> }
                    </li>
                }
            </ul>
    </text>;

    private string Summary
    {
        get
        {
            int lines = order?.Lines.Count ?? 0;
            return $"{lines} {(lines == 1 ? "line" : "lines")} · {Money(order?.Lines.Sum(line => line.Price.Amount * line.Quantity) ?? 0m)}";
        }
    }

    protected override Task OnParametersSetAsync()
    {
        if (orderShop != LocationId || openedOrder != OrderId || openedCall != CallId)
        {
            orderShop = LocationId; openedOrder = OrderId; openedCall = CallId; orderId = OrderId ?? Guid.NewGuid(); expanded.Clear();
            lowTab = false; ResetEntry();
        }
        return base.OnParametersSetAsync();
    }

    protected override void Clear()
    {
        rep = null; detail = null; index = null; order = null; problem = null; readStanding = OrderStanding.New; sentUtc = null;
        savedCall = null; carried = null; ResetEntry();
    }

    private void ShowPad() { lowTab = false; CloseLow(); }

    private void ShowLow() { lowTab = true; selected = null; addError = null; }

    // The popover opens empty from every route (T7.7); it closes on add, back to the Low tab (US-008 S14).
    private void OpenLow(LowItem item, ProductSearchResult product)
    {
        if (busy) return;
        lowProduct = product; lowEntry = item.Entry; lowRecorded = item.WhatWasRecorded; lowError = null;
    }

    private void CloseLow()
    {
        if (busy) return;
        lowProduct = null; lowEntry = null; lowRecorded = null; lowError = null;
    }

    private async Task AddLowAsync(decimal quantity)
    {
        if (busy || rep is null || lowProduct is not { } product) return;
        busy = true;
        lowError = null;
        string repSubject = rep;
        Guid shop = LocationId, id = orderId;
        Guid? call = CallId;
        long version = Tablet.SessionVersion;
        try
        {
            OrderResult result = await Task.Run(() => Add(repSubject, id, shop, product.Id, quantity, call));
            if (version != Tablet.SessionVersion || orderShop != shop) return;
            if (result.Succeeded) { Added(result.Order); lowProduct = null; lowEntry = null; lowRecorded = null; }
            else lowError = result.Error;
        }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (version == Tablet.SessionVersion) lowError = SaveFailed;
        }
        finally { busy = false; }
    }

    // Opened from a Call, a line links a new order to it (D3); otherwise the plain add, exactly as before.
    private OrderResult Add(string repSubject, Guid id, Guid shop, Guid product, decimal quantity, Guid? call) => call is Guid forCall
        ? Tablet.AddOrderLineForCall(repSubject, id, shop, product, quantity, forCall)
        : Tablet.AddOrderLine(repSubject, id, shop, product, quantity);

    private void Added(TabletOrder? saved)
    {
        order = saved;
        if (rep is not null && CallId is not null && Draft is { } draft)
            Tablet.CallDrafts.Keep(rep, Tablet.SessionVersion, LocationId, draft with { AddedToOrder = true });
    }

    // D5: the one fact the order can't tell. A product whose line this screen took off (or whose order it deleted) reads REMOVED
    // on the Call's Low tab, until it is on the order again.
    private void TookOff(TabletOrder? before, TabletOrder? after)
    {
        if (rep is null || before is null || Draft is not { } draft) return;
        Guid[] gone = [.. before.Lines.Select(line => line.ProductId).Except(after?.Lines.Select(line => line.ProductId) ?? [])];
        if (gone.Length > 0) Tablet.CallDrafts.Keep(rep, Tablet.SessionVersion, LocationId, draft.TakeOff(gone));
    }

    private void Toggle(Guid category) { if (!expanded.Remove(category)) expanded.Add(category); }

    private decimal? OnOrder(Guid product) =>
        order?.Lines.Where(line => line.ProductId == product).Select(line => line.Quantity).DefaultIfEmpty().Sum() is decimal sum and > 0 ? sum : null;

    private void ResetEntry()
    {
        ++revision; query = ""; results = new([], 0); selected = null; quantityText = ""; addError = null; readyError = null;
        editingLine = null; lineError = null; confirm = null;
    }

    protected override async Task ReadAsync(string repSubject, Func<bool> isCurrent)
    {
        Guid shop = LocationId, id = orderId;
        Guid? openedFrom = CallId;
        bool saved = OrderId is not null;
        try
        {
            OfflineLocationDetail? readDetail = null;
            ProductSearchIndex? readIndex = null;
            OrderView? readView = null;
            TabletCall? readCall = null;
            CarriedLow? readCarried = null;
            await Task.Run(() =>
            {
                readDetail = Tablet.ReadLocation(repSubject, shop);
                // A new order needs the shop assigned; a saved one opens whatever happened to the shop since (D4).
                if (!saved && readDetail is not { IsAssigned: true }) return;
                readIndex = Tablet.ReadProductIndex(repSubject);
                readView = Tablet.ReadOrderView(repSubject, id);
                // T-5.1.4 D4: once the Call is saved, its Low marks come from the saved Call.
                if ((openedFrom ?? readView?.Order.CallId) is Guid call) readCall = Tablet.ReadCall(repSubject, call);
                // T-5.1.5: with no Call, the gaps the shop's last Call left, from the same downloaded day as the products.
                else if (readIndex is not null) readCarried = Tablet.ReadCarriedLow(repSubject, shop, id, readIndex);
            });
            if (!isCurrent()) return;
            rep = repSubject; detail = readDetail; index = readIndex; savedCall = readCall; carried = readCarried;
            order = readView?.Order; readStanding = readView?.Standing ?? OrderStanding.New; sentUtc = readView?.SentUtc;
            if (order is not null && order.LocationId != shop) problem = "This order is for a different shop.";
        }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (isCurrent()) problem = "Order entry couldn't be opened. Your saved work is still on this tablet.";
        }
    }

    private async Task SearchAsync(ChangeEventArgs args)
    {
        long started = Stopwatch.GetTimestamp();
        int current = ++revision;
        query = args.Value?.ToString() ?? "";
        results = new([], 0);
        if (!Ready || index is null || string.IsNullOrWhiteSpace(query)) return;
        ProductSearchIndex captured = index;
        string text = query;
        ProductSearchOutcome found = await Task.Run(() => captured.Search(text));
        if (current != revision) return;
        results = found;
        searchStarted = started;
    }

    // Device evidence for "search within 1 second": the time to the painted results, read in the WebView (no query text is logged).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (searchStarted is not long started) return;
        searchStarted = null;
        if (Services.GetService<IJSRuntime>() is not { } js) return;
        int current = revision, matches = results.Results.Count, total = results.Total;
        try
        {
            double visibleMs = await js.InvokeAsync<double>("fieldSalesSearchAfterPaint", matches, ".product-result");
            if (current == revision)
                TabletTiming.ProductSearchShown(index?.Count ?? 0, total, TimeSpan.FromMilliseconds(visibleMs), Stopwatch.GetElapsedTime(started));
        }
        catch (JSException) { }
    }

    private void Select(ProductSearchResult product) { selected = product; quantityText = ""; addError = null; }

    private void QuantityChanged(ChangeEventArgs args) { quantityText = args.Value?.ToString() ?? ""; addError = null; }

    private QuantityRules? SelectedRules => selected is { } product
        && QuantityRules.TryCreate(product.Unit, product.QuantityStep, product.MinimumQuantity, out QuantityRules? rules, out _) ? rules : null;

    private decimal ParsedQuantity => decimal.TryParse(quantityText.Trim(), NumberStyles.AllowDecimalPoint,
        CultureInfo.InvariantCulture, out decimal amount) ? amount : 0m;

    private QuantityValidationResult? MeasureValidation => selected is { Unit: not "Each" } product && SelectedRules is { } rules
        ? OnOrder(product.Id) is > 0 ? rules.ValidateIncrement(ParsedQuantity) : rules.ValidateOrder(ParsedQuantity)
        : null;

    private bool ValidMeasure => MeasureValidation is { IsValid: true };
    private string? MeasureError => selected is { Unit: not "Each" } && quantityText.Length > 0
        ? SelectedRules is null ? "This product's ordering rules couldn't be read." : MeasureValidation?.Error : null;

    private decimal? NextQuantity(bool increase)
    {
        if (SelectedRules is not { } rules) return null;
        if (string.IsNullOrWhiteSpace(quantityText)) return increase ? rules.Minimum.Amount : null;
        decimal current = ParsedQuantity;
        if (!rules.ValidateOrder(current).IsValid) return null;
        decimal next = current + (increase ? rules.Step.Amount : -rules.Step.Amount);
        return rules.ValidateOrder(next).IsValid ? next : null;
    }

    private bool CanStep(bool increase) => !busy && selected?.Price is not null && NextQuantity(increase).HasValue;

    private void StepQuantity(bool increase)
    {
        if (!CanStep(increase) || NextQuantity(increase) is not decimal next) return;
        quantityText = next.ToString("0.0#####", CultureInfo.InvariantCulture);
        addError = null;
    }

    private async Task AddAsync()
    {
        if (busy || rep is null || selected is not { Price: not null } product) return;
        if (product.Unit != "Each" && !ValidMeasure) return;
        busy = true;
        addError = null;
        string repSubject = rep;
        Guid shop = LocationId, id = orderId;
        Guid? call = CallId;
        long version = Tablet.SessionVersion;
        // Only digits and a decimal point count; anything else is "no quantity", and the product's own rule says what to enter.
        decimal quantity = decimal.TryParse(quantityText.Trim(), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out decimal parsed) ? parsed : 0m;
        try
        {
            OrderResult result = await Task.Run(() => Add(repSubject, id, shop, product.Id, quantity, call));
            if (version != Tablet.SessionVersion || orderShop != shop) return;
            if (result.Succeeded) { Added(result.Order); ResetEntry(); }
            else addError = result.Error;
        }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (version == Tablet.SessionVersion) addError = SaveFailed;
        }
        finally { busy = false; }
    }

    private async Task MarkReadyAsync()
    {
        if (busy || rep is null) return;
        busy = true;
        readyError = null;
        string repSubject = rep;
        Guid shop = LocationId, id = orderId;
        long version = Tablet.SessionVersion;
        try
        {
            OrderResult result = await Task.Run(() => Tablet.MarkOrderReady(repSubject, id));
            if (version != Tablet.SessionVersion || orderShop != shop) return;
            if (result.Succeeded) { order = result.Order; ResetEntry(); }
            else readyError = result.Error;
        }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (version == Tablet.SessionVersion) readyError = SaveFailed;
        }
        finally { busy = false; }
    }

    private void SaveAndClose() => Navigation.NavigateTo(BackHref);

    // T-5.2.1: changes to a saved order. The store applies OrderTransitions; the screen only offers what the standing allows.
    private void StartChange(OrderLine line)
    {
        if (busy || !CanChangeLines) return;
        editingLine = line.Id; editText = Number(line.Quantity, line.Unit); lineError = null; readyError = null;
    }

    private void CancelChange() { editingLine = null; lineError = null; }

    private void EditChanged(ChangeEventArgs args) { editText = args.Value?.ToString() ?? ""; lineError = null; }

    private QuantityRules? EditRules(OrderLine line) => index?.Find(line.ProductId) is { } product
        && QuantityRules.TryCreate(product.Unit, product.QuantityStep, product.MinimumQuantity, out QuantityRules? rules, out _) ? rules : null;

    private decimal? EditStep(QuantityRules rules, bool increase)
    {
        decimal current = ParseQuantity(editText);
        if (!rules.ValidateOrder(current).IsValid) return null;
        decimal next = current + (increase ? rules.Step.Amount : -rules.Step.Amount);
        return rules.ValidateOrder(next).IsValid ? next : null;
    }

    private void StepEdit(QuantityRules rules, bool increase)
    {
        if (busy || EditStep(rules, increase) is not decimal next) return;
        editText = next.ToString("0.0#####", CultureInfo.InvariantCulture);
        lineError = null;
    }

    private async Task SaveChangeAsync(OrderLine line)
    {
        decimal quantity = ParseQuantity(editText);
        if (await ActAsync((repSubject, id) => Tablet.ChangeOrderLine(repSubject, id, line.Id, quantity)) is not { } result) return;
        if (result.Succeeded || Standing != OrderStanding.InProgress) editingLine = null;
        if (!result.Succeeded) { if (editingLine is null) readyError = result.Error; else lineError = result.Error; }
    }

    private async Task RemoveAsync(OrderLine line)
    {
        if (busy || !CanChangeLines) return;
        // S4: the last line goes only with the order, so ask first.
        if (order!.Lines.Count == 1) { confirm = Confirmation.LastLine(line.Id); editingLine = null; return; }
        OrderResult? result = await ActAsync((repSubject, id) => Tablet.RemoveOrderLine(repSubject, id, line.Id, false));
        if (result is { NeedsConfirmation: true }) confirm = Confirmation.LastLine(line.Id);
        else if (result is { Succeeded: false }) readyError = result.Error;
    }

    private void AskDelete()
    {
        if (busy) return;
        confirm = Confirmation.DeleteOrder; editingLine = null; readyError = null;
    }

    private async Task ConfirmAsync()
    {
        if (confirm is not { } ask) return;
        OrderResult? result = await ActAsync((repSubject, id) => ask.LineId is Guid line
            ? Tablet.RemoveOrderLine(repSubject, id, line, true) : Tablet.DeleteOrder(repSubject, id, true));
        if (result is null || result.Deleted) return;
        confirm = null;
        if (!result.Succeeded) readyError = result.Error;
    }

    private async Task ReopenAsync()
    {
        if (await ActAsync((repSubject, id) => Tablet.ReopenOrder(repSubject, id)) is not { } result) return;
        if (result.Succeeded) ResetEntry();
        else readyError = result.Error;
    }

    /// <summary>Runs one change on a worker thread for the rep and session that started it. A deleted order returns the rep to
    /// the shop, or to the Call it was opened from. A refused change re-reads the order, because a Sync may have claimed, sent or
    /// refused it meanwhile.</summary>
    private async Task<OrderResult?> ActAsync(Func<string, Guid, OrderResult> change)
    {
        if (busy || rep is null) return null;
        busy = true;
        readyError = null; lineError = null;
        string repSubject = rep;
        Guid shop = LocationId, id = orderId;
        long version = Tablet.SessionVersion;
        TabletOrder? before = order;
        try
        {
            OrderResult result = await Task.Run(() => change(repSubject, id));
            if (version != Tablet.SessionVersion || orderShop != shop) return null;
            if (result.Deleted) { TookOff(before, null); Navigation.NavigateTo(BackHref); return result; }
            if (result.Succeeded) { TookOff(before, result.Order); order = result.Order; return result; }
            if (!result.NeedsConfirmation)
            {
                OrderView? now = await Task.Run(() => Tablet.ReadOrderView(repSubject, id));
                if (version != Tablet.SessionVersion || orderShop != shop) return null;
                if (now is not null) { order = now.Order; readStanding = now.Standing; sentUtc = now.SentUtc; }
            }
            return result;
        }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (version == Tablet.SessionVersion) readyError = SaveFailed;
            return null;
        }
        finally { busy = false; }
    }

    private static decimal ParseQuantity(string text) =>
        decimal.TryParse(text.Trim(), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out decimal amount) ? amount : 0m;

    private static string Money(decimal amount) => "€" + amount.ToString("N2", CultureInfo.InvariantCulture);
    private static string PerUnit(string unit) => unit == "Each" ? "" : $" per {unit}";
    private static string LineQuantity(OrderLine line) => Quantity(line.Quantity, line.Unit);
    private static string Number(decimal quantity, string unit) =>
        quantity.ToString(unit == "Each" ? "0" : "0.0#####", CultureInfo.InvariantCulture);
    private static string Quantity(decimal quantity, string unit) => Number(quantity, unit) + (unit == "Each" ? "" : $" {unit}");
}
