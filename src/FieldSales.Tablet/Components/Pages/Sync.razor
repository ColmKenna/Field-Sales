@page "/sync"
@implements IDisposable
@inject TabletApp Tablet
@inject NavigationManager Navigation

@* T-01 · Sync (last sync, Sync now, "Sending 2 of 3" then the download, and why a Sync didn't complete: what happened to
   the rep's finished work, then to their day, T-4.1.3). Unsent sections arrive with T-4.3.1. *@
<section class="sync">
    <h1>Sync</h1>
    @if (home is not null)
    {
        <p class="last-sync">@home.LastSynced</p>
        @if (unsent is { Total: > 0 })
        {
            <p class="unsent-summary" role="status">@UnsentText</p>
        }
        <div class="sync-region">
            @if (busy && sending is { Total: > 0 } progress)
            {
                <p role="status">Sending @progress.Sending of @progress.Total…</p>
                <progress value="@progress.Sending" max="@progress.Total"></progress>
            }
            else if (busy)
            {
                <p role="status">Downloading your day…</p>
            }
            else if (signInNeeded)
            {
                <button class="primary" disabled="@signingIn" @onclick="SignInAsync">Sign in</button>
            }
            else
            {
                <button class="primary" disabled="@(!Tablet.Connected)" @onclick="SyncAsync">Sync now</button>
            }
        </div>
        @if (work is not null)
        {
            <p class="problem" role="status">@work</p>
        }
        @if (signInNeeded)
        {
            <p>After sign-in, this Sync resumes automatically.</p>
        }
        @if (message is not null)
        {
            <p class="problem" role="status">@message</p>
        }
        @if (signInProblem is not null)
        {
            <p class="problem" role="alert">@signInProblem</p>
        }
        @if (home.Locations.Count > 0)
        {
            <button class="link" @onclick="BackToHome">Back to Home</button>
        }
    }
</section>

@code {
    private string? rep;
    private HomeView? home;
    private UnsentSummary? unsent;
    private string? message;
    private string? work;
    private UploadProgress? sending;
    private bool busy;
    private bool signInNeeded;
    private bool signingIn;
    private string? signInProblem;
    private int load;
    private bool disposed;
    private readonly CancellationTokenSource viewWork = new();

    protected override async Task OnInitializedAsync()
    {
        Tablet.Resumed += OnResumed;
        Tablet.SyncNotices.Changed += OnNoticeChanged;
        await GuardAsync(Tablet.EnterOnArrivalAsync);
        await ResumeIfAskedAsync();
    }

    // WI-041 (I3.2): the rep already asked to Sync, so once they have signed in again from this screen, the new session's Sync
    // screen carries on with it. Only that sign-in asks; signal returning or the app resuming never does (T1.3).
    private async Task ResumeIfAskedAsync()
    {
        if (!busy && !disposed && rep is not null && Tablet.SyncNotices.TakeResume(rep, Tablet.SessionVersion)) await SyncAsync();
    }

    private async Task GuardAsync(Func<Task<TabletEntry>> enter)
    {
        int current = ++load;
        long version = Tablet.SessionVersion;
        home = null; rep = null; message = null; unsent = null;
        StateHasChanged();
        TabletEntry entry = await enter();
        if (disposed || current != load || version != Tablet.SessionVersion) return;
        if (entry.Screen is not (EntryScreen.Sync or EntryScreen.Home)) { Navigation.NavigateTo("/"); return; }
        rep = entry.RepSubject!;
        HomeView read = Tablet.ReadHome(rep);
        if (version != Tablet.SessionVersion) { rep = null; return; }
        home = read;
        unsent = ReadUnsent(rep);
        ShowNotice();
    }

    // What this screen last told the rep in this session. Returning from the sign-in browser resumes the app, which rebuilds this
    // page, so the app keeps it and the new page shows the same.
    private void ShowNotice()
    {
        SyncNotice? notice = rep is null ? null : Tablet.SyncNotices.Read(rep, Tablet.SessionVersion);
        (work, message) = notice?.Report ?? new SyncReport(null, null);
        signInNeeded = notice?.SignInNeeded ?? false;
        signInProblem = notice?.SignInProblem;
        // Without signal, say so, unless the work line already does.
        if (!Tablet.Connected && work != SyncMessages.NoConnection) message ??= SyncMessages.NoConnection;
    }

    // A sign-in answer can arrive after this page was rebuilt; the page that shows the notice then shows it, or resumes the Sync.
    private void OnNoticeChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed || busy || rep is null) return;
        ShowNotice();
        StateHasChanged();
        await ResumeIfAskedAsync();
    });

    // The count is a courtesy: a saved item that cannot be counted must never stop the rep syncing.
    private UnsentSummary? ReadUnsent(string repSubject)
    {
        try { return Tablet.ReadUnsentSummary(repSubject); }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException or System.Text.Json.JsonException) { return null; }
    }

    private int ReadWaiting(string repSubject)
    {
        try { return Tablet.CountWaitingToSend(repSubject); }
        catch (Exception error) when (error is InvalidDataException or IOException or Microsoft.Data.Sqlite.SqliteException or System.Text.Json.JsonException) { return 0; }
    }

    private string UnsentText
    {
        get
        {
            List<string> parts = [$"Unsent: {unsent!.Total}"];
            if (unsent.ReadyToSend > 0) parts.Add($"{unsent.ReadyToSend} ready to send");
            if (unsent.InProgress > 0) parts.Add($"{unsent.InProgress} in progress");
            return string.Join(" · ", parts);
        }
    }

    private async Task SyncAsync()
    {
        if (busy || disposed || rep is null) return;
        string capturedRep = rep;
        long version = Tablet.SessionVersion;
        // "Sending 1 of 3…" from the tap: the session check and the sign-in token come before the first report.
        int waiting = ReadWaiting(capturedRep);
        busy = true; message = null; work = null; signInNeeded = false; signInProblem = null; sending = waiting > 0 ? new(1, waiting) : null;
        Tablet.SyncNotices.Keep(capturedRep, version, null);
        // Reports arrive on this page's context, one per item, then once more when the uploads are over.
        Progress<UploadProgress> progress = new(report =>
        {
            if (disposed || !busy || version != Tablet.SessionVersion) return;
            sending = report;
            StateHasChanged();
        });
        SyncOutcome outcome = await Tablet.SyncAsync(capturedRep, viewWork.Token, progress);
        if (disposed || version != Tablet.SessionVersion) return;
        busy = false; sending = null;
        // Home only when everything went; otherwise the rep stays here to read what didn't, and why.
        if (outcome.Completed && outcome.Upload.NotSent == 0) { Navigation.NavigateTo("/home"); return; }
        // US-001 S3: nothing more goes until the rep signs in again, so Sign in takes Sync now's place.
        Tablet.SyncNotices.Keep(capturedRep, version, new(SyncMessages.Explain(outcome), outcome.Status == SyncStatus.SignInRequired));
        ShowNotice();
        home = Tablet.ReadHome(capturedRep);
        unsent = ReadUnsent(capturedRep);
    }

    // The entry screen's connected sign-in. Success changes the session, so this page reopens for the signed-in rep with
    // Sync now; resuming the Sync automatically is WI-041's.
    private async Task SignInAsync()
    {
        if (signingIn || busy || disposed || rep is null) return;
        string signingRep = rep;
        long version = Tablet.SessionVersion;
        signingIn = true; signInProblem = null;
        SignInAnswer answer = await Tablet.SignInAsync();
        // Returning from the browser has usually rebuilt this page by now, so what happened goes through the app. A sign-in as the
        // same rep started a new session, whose Sync screen resumes the Sync; anything else leaves the notice with the answer.
        if (answer.SignedInRep == signingRep && version != Tablet.SessionVersion)
            Tablet.SyncNotices.RequestResume(signingRep, Tablet.SessionVersion);
        else if (version == Tablet.SessionVersion && Tablet.SyncNotices.Read(signingRep, version) is { } shown)
            Tablet.SyncNotices.Keep(signingRep, version, shown with { SignInProblem = answer.Problem });
        if (disposed) return;
        signingIn = false;
        signInProblem = answer.Problem;
    }

    private void BackToHome()
    {
        if (rep is not null) Tablet.SyncNotices.Keep(rep, Tablet.SessionVersion, null);
        Navigation.NavigateTo("/home");
    }

    private void OnResumed() => _ = InvokeAsync(async () => { await GuardAsync(Tablet.EnterAsync); StateHasChanged(); });

    public void Dispose()
    {
        disposed = true; ++load; home = null; rep = null;
        viewWork.Cancel(); viewWork.Dispose();
        Tablet.Resumed -= OnResumed;
        Tablet.SyncNotices.Changed -= OnNoticeChanged;
    }
}
