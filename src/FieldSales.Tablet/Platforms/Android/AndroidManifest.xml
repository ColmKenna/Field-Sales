<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The snapshot and Unsent databases never leave the tablet through backup or device transfer (1C).
         Android file-based encryption protects them at rest. -->
    <application android:allowBackup="false" android:fullBackupContent="false"
                 android:dataExtractionRules="@xml/data_extraction_rules"
                 android:networkSecurityConfig="@xml/network_security_config"
                 android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sign-in opens the system browser (RFC 8252); Android 11+ needs this to find a Custom Tabs browser. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
