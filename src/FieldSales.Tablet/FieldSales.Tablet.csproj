<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- 1C: Android first; the iPad target is added once the deferred iPad check passes (D4). -->
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>FieldSales.Tablet</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>Field Sales</ApplicationTitle>
        <ApplicationId>com.fieldsales.tablet</ApplicationId>
        <AndroidPackageFormats>apk</AndroidPackageFormats>
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

        <!-- Where this build signs in and syncs. Development builds use this PC through adb reverse. -->
        <FieldSalesApiBaseUrl Condition="'$(FieldSalesApiBaseUrl)' == ''">https://localhost:7204/</FieldSalesApiBaseUrl>
        <FieldSalesIdentityBaseUrl Condition="'$(FieldSalesIdentityBaseUrl)' == ''">https://localhost:7201/</FieldSalesIdentityBaseUrl>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>FieldSalesApiBaseUrl</_Parameter1>
            <_Parameter2>$(FieldSalesApiBaseUrl)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>FieldSalesIdentityBaseUrl</_Parameter1>
            <_Parameter2>$(FieldSalesIdentityBaseUrl)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <!--
        P8: a build given FieldSalesDevCertificate (this PC's ASP.NET development certificate, public part only,
        exported by scripts/tablet-app.ps1) trusts it for localhost alone. Every other build trusts system CAs only.
    -->
    <ItemGroup Condition="'$(FieldSalesDevCertificate)' != ''">
        <AndroidResource Include="$(FieldSalesDevCertificate)" Link="Resources\raw\fieldsales_dev_cert.der" />
        <AndroidResource Include="Platforms\Android\Security\network_security_config.devtrust.xml" Link="Resources\xml\network_security_config.xml" />
    </ItemGroup>
    <ItemGroup Condition="'$(FieldSalesDevCertificate)' == ''">
        <AndroidResource Include="Platforms\Android\Security\network_security_config.xml" Link="Resources\xml\network_security_config.xml" />
    </ItemGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F4E79" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F4E79" BaseSize="128,128" />
        <MauiFont Include="Resources\Fonts\*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <ProjectReference Include="..\FieldSales.Tablet.Core\FieldSales.Tablet.Core.csproj" />
    </ItemGroup>

</Project>
