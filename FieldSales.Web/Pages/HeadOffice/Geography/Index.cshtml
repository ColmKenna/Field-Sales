@page
@model FieldSales.Web.Pages.HeadOffice.Geography.IndexModel
@{
    ViewData["Title"] = "Geography";
}
<h1>Geography</h1>
<nav aria-label="Geography path">
    <a asp-page="Index">Regions</a>
    @foreach (var part in Model.Geography.Path)
    {
        <span aria-hidden="true"> › </span>
        @if (part.Level == "regions")
        {
            <a asp-page="Index" asp-route-regionId="@part.Id">@part.Name</a>
        }
        else
        {
            <a asp-page="Index" asp-route-countyId="@part.Id">@part.Name</a>
        }
    }
</nav>
@if (Model.Notice is not null)
{
    <p role="status">@Model.Notice</p>
}
<div class="geography-errors" asp-validation-summary="All" role="alert"></div>
<h2>@Model.Plural</h2>
@if (Model.Geography.Items.Count == 0)
{
    <p>No @Model.Geography.Level yet.</p>
}
else
{
    <ul class="geography-list">
    @foreach (var item in Model.Geography.Items)
    {
        <li>
            @if (Model.Geography.Level == "regions")
            {
                <a asp-page="Index" asp-route-regionId="@item.Id">@item.Name</a>
            }
            else if (Model.Geography.Level == "counties")
            {
                <a asp-page="Index" asp-route-countyId="@item.Id">@item.Name</a>
            }
            else
            {
                <span>@item.Name — @Model.Geography.Path.Last().Name</span>
            }
            <details class="geography-rename" open="@(Model.RenameId == item.Id && !ViewData.ModelState.IsValid ? "open" : null)">
                <summary>Rename @item.Name</summary>
                <form class="product-form geography-form" method="post" asp-page-handler="Rename" asp-route-regionId="@Model.RegionId" asp-route-countyId="@Model.CountyId">
                    <input type="hidden" name="RenameId" value="@item.Id" />
                    <input type="hidden" name="Version" value="@(Model.RenameId == item.Id && !ViewData.ModelState.IsValid ? Model.Version : item.Version)" />
                    <label for="rename-@item.Id">@Model.Singular name</label>
                    <input id="rename-@item.Id" name="RenameName" maxlength="200" value="@(Model.RenameId == item.Id && !ViewData.ModelState.IsValid ? Model.RenameName : item.Name)" />
                    <button class="button" type="submit">Save name</button>
                </form>
            </details>
        </li>
    }
    </ul>
}
<h2>Add @Model.Singular.ToLowerInvariant()</h2>
<form class="product-form" method="post" asp-page-handler="Create" asp-route-regionId="@Model.RegionId" asp-route-countyId="@Model.CountyId">
    <label asp-for="Name">@Model.Singular name</label>
    <input asp-for="Name" maxlength="200" />
    <span asp-validation-for="Name"></span>
    <button class="button" type="submit">Add @Model.Singular.ToLowerInvariant()</button>
</form>
<details class="geography-import">
    <summary>Import towns from CSV</summary>
    <p>You can enter geography manually or import a CSV with the columns Region, County, Town.</p>
    <p>Import adds missing places and keeps existing ones. Maximum file size: 1 MiB; maximum towns: 10,000.</p>
    <pre>Region,County,Town
Leinster,Wicklow,Rathdrum</pre>
    <form class="product-form" method="post" enctype="multipart/form-data" asp-page-handler="Import" asp-route-regionId="@Model.RegionId" asp-route-countyId="@Model.CountyId">
        <label asp-for="Upload">CSV file</label>
        <input asp-for="Upload" type="file" accept=".csv,text/csv" />
        <span asp-validation-for="Upload"></span>
        <button class="button" type="submit">Import geography</button>
    </form>
</details>
