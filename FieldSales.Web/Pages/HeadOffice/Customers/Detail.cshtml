@page "{id:guid}"
@model FieldSales.Web.Pages.HeadOffice.Customers.DetailModel
@{ ViewData["Title"] = Model.Customer.Name; }
<p><a asp-page="Index">Back to customers</a></p>
<h1>@Model.Customer.Name</h1>
<section aria-labelledby="locations-heading">
    <h2 id="locations-heading">Locations</h2>
    <p><a asp-page="/HeadOffice/Locations/Create" asp-route-customerId="@Model.Customer.Id">Add location</a></p>
    <div class="directory-table">
        <table>
            <caption>Locations belonging to @Model.Customer.Name</caption>
            <thead><tr><th scope="col">Location</th><th scope="col">Town</th><th scope="col">Type</th><th scope="col">Master</th><th scope="col">Closure</th></tr></thead>
            <tbody>
            @foreach (var location in Model.Customer.Locations)
            {
                <tr data-location-id="@location.Id">
                    <td><a asp-page="/HeadOffice/Locations/Detail" asp-route-id="@location.Id">@location.Name</a></td>
                    <td>@location.Town.Label</td><td>@location.Type?.Label</td><td></td><td></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
