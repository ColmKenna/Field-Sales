@page "{id:guid}"
@model FieldSales.Web.Pages.HeadOffice.Locations.DetailModel
@using System.Globalization
@using FieldSales.Directory.Contracts
@{ ViewData["Title"] = Model.Location.Name; }
<p><a asp-page="/HeadOffice/Customers/Detail" asp-route-id="@Model.Location.CustomerId">Back to @Model.Location.CustomerName</a></p>
<h1>@Model.Location.Name</h1>
<dl>
    <dt>Customer</dt><dd><a asp-page="/HeadOffice/Customers/Detail" asp-route-id="@Model.Location.CustomerId">@Model.Location.CustomerName</a></dd>
    <dt>Town</dt><dd>@Model.Location.Town.Label</dd>
    <dt>Eircode</dt><dd>@(Model.Location.Eircode ?? "None entered")</dd>
    <dt>Type</dt><dd>@(Model.Location.Type?.Label ?? "No type")</dd>
    <dt>Map position</dt>
    @if (Model.Location.Position is { } position)
    {
        <dd class="location-position">@position.Latitude.ToString(CultureInfo.InvariantCulture), @position.Longitude.ToString(CultureInfo.InvariantCulture)</dd>
        <dt>Precision</dt>
        <dd class="location-precision">@(position.Precision switch
            {
                LocationPositionPrecision.Town => "Town — approximate: the Town's position, not the shop's",
                LocationPositionPrecision.Eircode => "Eircode — from the Eircode lookup",
                _ => "Confirmed on site"
            }) · set on <time datetime="@position.PositionedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@position.PositionedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</time></dd>
    }
    else
    {
        <dd class="location-position"><strong>Position needed</strong>. No map position has been set for this location yet.
            A position is taken from the Town's coordinates, or failing that the Eircode, when the location is created or its Town or Eircode changes.</dd>
    }
</dl>
<h2>Contacts</h2>
@if (TempData["ContactNotice"] is string notice) { <p role="status">@notice</p> }
@if (Model.Contacts.ReplacementNeeded)
{
    <p class="main-contact-gap" role="status">
        @if (Model.Contacts.RetiredMainContact is { Status: FieldSales.Directory.Contracts.ContactStatus.Inactive } outgoing)
        { <span>Main contact: @outgoing.Name (inactive) — replacement needed</span><br /><strong>Main contact inactive — replacement needed</strong> }
        else
        { <strong>Main contact replacement needed</strong><span>. Choose an Active contact as Main; reactivation does not fill this gap.</span> }
    </p>
}
else
{ <p>Main contact: @(Model.Contacts.MainContact?.Name ?? "None yet")</p> }
<p><a asp-page="/HeadOffice/Contacts/Create" asp-route-locationId="@Model.Location.Id">Create contact</a>
    | <a asp-page="/HeadOffice/Contacts/Link" asp-route-locationId="@Model.Location.Id">Link existing contact</a></p>
@if (Model.Contacts.InactiveCount > 0)
{
    <p><a asp-page="Detail" asp-route-id="@Model.Location.Id" asp-route-ShowInactive="@(!Model.ShowInactive)">@(Model.ShowInactive ? "Hide inactive" : $"Show inactive ({Model.Contacts.InactiveCount})")</a></p>
}
@if (Model.Contacts.Contacts.Count == 0) { <p>No active contacts linked yet.</p> }
<ul>
    @foreach (var link in Model.Contacts.Contacts)
    {
        <li data-contact-id="@link.Contact.Id">
            <a asp-page="/HeadOffice/Contacts/Detail" asp-route-id="@link.Contact.Id">@link.Contact.Name</a>
            — @link.Contact.Type.Label @(link.Contact.Status == FieldSales.Directory.Contracts.ContactStatus.Inactive ? "(inactive)" : "")
            @if (link.IsMain) { <strong>Main</strong> }
            else if (link.Contact.Status == FieldSales.Directory.Contracts.ContactStatus.Active)
            { <a asp-page="/HeadOffice/Contacts/Main" asp-route-id="@Model.Location.Id" asp-route-contactId="@link.Contact.Id">Set Main</a> }
        </li>
    }
</ul>
<h2>Edit location</h2>
<form method="post" class="product-form">
    <div asp-validation-summary="All" role="alert"></div>
    <input asp-for="Version" type="hidden" />
    <partial name="_LocationFields" model="Model" />
    @if (Model.DuplicateWarning)
    {
        <p>Change the name, or keep the same name as another location.</p>
        <button type="submit" asp-page-handler="Confirm">Save anyway</button>
    }
    <button type="submit" class="button">Save changes</button>
    <a asp-page="Detail" asp-route-id="@Model.Location.Id">Cancel and reload</a>
</form>
