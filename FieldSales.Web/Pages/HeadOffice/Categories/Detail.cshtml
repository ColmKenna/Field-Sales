@page "/HeadOffice/Categories/{id:guid}"
@model FieldSales.Web.Pages.HeadOffice.Categories.DetailModel
@{
    ViewData["Title"] = Model.Details.Category.Name;
}
<nav aria-label="Category path">
    <a asp-page="Index">Categories</a>
    @foreach (var segment in Model.Details.Breadcrumb)
    {
        <span aria-hidden="true"> / </span>
        <a asp-page="Detail" asp-route-id="@segment.Id">@segment.Name</a>
    }
</nav>
<h1>@Model.Details.Category.Name</h1>
<form method="post" asp-page-handler="Rename">
    <label asp-for="RenameName">Category name</label>
    <input asp-for="RenameName" maxlength="200" />
    <span asp-validation-for="RenameName"></span>
    <button type="submit">Rename category</button>
</form>
<form method="post">
    <label asp-for="Name">Subcategory name</label>
    <input asp-for="Name" maxlength="200" />
    <span asp-validation-for="Name"></span>
    <button type="submit">Add subcategory</button>
</form>
<h2>Subcategories</h2>
@if (Model.Details.Children.Count == 0)
{
    <p>No subcategories yet.</p>
}
else
{
    <ul>
    @foreach (var category in Model.Details.Children)
    {
        <li><a asp-page="Detail" asp-route-id="@category.Id">@category.Name</a></li>
    }
    </ul>
}
