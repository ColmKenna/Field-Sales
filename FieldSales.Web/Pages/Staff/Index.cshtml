@page "/Staff"
@model FieldSales.Web.Pages.Staff.IndexModel
@{
    ViewData["Title"] = "Staff workspace";
}
<h1>Staff workspace</h1>
<p>Signed in as @User.Identity?.Name.</p>
@if (Model.ApiAvailable)
{
    <p role="status">Your staff API session is active.</p>
}
else
{
    <p role="alert">The staff API session could not be checked. Try signing in again.</p>
}
<ul>
    @if (User.IsInRole("Field Salesperson")) { <li><a asp-page="/Rep/Index">Field sales</a></li> }
    @if (User.IsInRole("Sales Manager")) { <li><a asp-page="/Manager/Index">Sales manager</a></li> }
    @if (User.IsInRole("Head Office User")) { <li><a asp-page="/HeadOffice/Index">Head office</a></li> }
</ul>
