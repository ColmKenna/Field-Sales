    <RazorComponent Include="../../../src/FieldSales.Tablet/Components/Pages/Sync.razor" Link="Sync.razor" />
    <RazorComponent Include="../../../src/FieldSales.Tablet/Components/Pages/LocationDetail.razor" Link="LocationDetail.razor" />
    <RazorComponent Include="../../../src/FieldSales.Tablet/Components/Pages/NewOrder.razor" Link="NewOrder.razor" />
    <RazorComponent Include="../../../src/FieldSales.Tablet/Components/Layout/SignOutControl.razor" Link="SignOutControl.razor" />
